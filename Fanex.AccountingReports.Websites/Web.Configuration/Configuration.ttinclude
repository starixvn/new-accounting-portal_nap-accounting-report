<#@ import namespace="System" #>
<#
    var sites = new SiteInfo[]{
		new SiteInfo
        {
            Environment = SiteEnvironment.DEV
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.LOCAL
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.SIT
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.UAT
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.MNL
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.PRO
        }
    };
#>
<#+
    enum SiteEnvironment
    {
		DEV,
        LOCAL,		
        SIT,
        UAT,
        MNL,
        PRO
    }
    class SiteInfo
    {
        public SiteEnvironment Environment { get; set; }

        #region For Webconfig file

	   public string FanexDataPath
	   {
		  get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "LIVE";
				default:
                        return "TEST";
                }
            }
	   }
	   
	   public string NapEnvironment
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "LIVE";
                    default:
                        return "UAT";
                }
            }
        }

        public string NapSiteId
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                        return "4";
                    default:
                        return "3";
                }
            }
        }

		public string NapEnableReCheckin
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.PRO:
						return "true";
					default:
                        return "false";
                }
            }
        }

		public string NapServiceUrls
		 {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
						return "http://ha.nexdev.net:1712/api";
                    case SiteEnvironment.SIT:
						return "http://172.16.4.106:1710/api";
                    case SiteEnvironment.UAT:
						return "http://10.40.40.248:1710/main/api";
					case SiteEnvironment.PRO:
						return "http://10.40.40.22:1710/api";
					case SiteEnvironment.MNL:
                        return "http://10.40.40.202:1710/api";
					default:
                        return string.Empty;
                }
            }
        }

		public string NapAccessKey
		 {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
						return "HTAiA6W/kzs0PjSnm3ll1kD7tXPyDyO0gTeD8Nz6078=";
                    case SiteEnvironment.SIT:
						return "ZU5inpesUej+dCIxitApgXAiRhK0N7uCuVHCCjPyT9o=";
                    case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
					case SiteEnvironment.MNL:
                        return "ZU5inpesUej+dCIxitApgXAiRhK0N7uCuVHCCjPyT9o=";
					default:
                        return string.Empty;
                }
            }
        }

		public string NapDomainName
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
						return "localhost:9902";
                    case SiteEnvironment.SIT:
                        return "nap-report.playthefun.com";
                    case SiteEnvironment.UAT:
						return "qa-accrpt.starific.net";
					case SiteEnvironment.PRO:
                        return "nap.oneops.net";
					case SiteEnvironment.MNL:
                        return "nap-report.ibcbk.com";
					default:
                        return string.Empty;
                }
            }
        }

		public string NapDomainPath
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
                    case SiteEnvironment.SIT:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
					case SiteEnvironment.MNL:
						return "/AccReport";
					default:
                        return string.Empty;
                }
            }
        }

		public string ONEbookUMAddress
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
					    return "http://ha.nexdev.net:8889/api";
                    case SiteEnvironment.PRO:
                        return "http://10.40.40.22:8889/api";
                    case SiteEnvironment.UAT:
                        return "http://10.40.40.248:8889/api";
                    case SiteEnvironment.SIT:
                        return "http://172.16.4.106:8889/api";
                    case SiteEnvironment.MNL:
                        return "http://10.40.40.202:8889/api";
                    default:
                        return string.Empty;
                }
            }
        }

        public string EnableCheckUM
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "true";
                    default:
                        return "false";
                }
            }
        }

		public string LoggingMsmqPath
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.UAT:
                        return @"FormatName:DIRECT=tcp:10.40.40.73\private$\entlib";
					case SiteEnvironment.SIT:
                        return @"FormatName:DIRECT=tcp:172.16.4.106\private$\entlib";
                    case SiteEnvironment.PRO:
                        return @"FormatName:DIRECT=tcp:10.40.40.22\private$\entlib";
                    case SiteEnvironment.MNL:
                        return @"FormatName:DIRECT=tcp:10.2.98.3\private$\entlib";
                    default:
                        return @"FormatName:DIRECT=tcp:10.18.200.103\private$\entlib";
                }
            }
        }

        public string LoggingDefaultCategory
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.UAT:
                        return "NAP-Report-UAT";
                    case SiteEnvironment.SIT:
						return "NAP-Report-SIT";
					case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "NAP-Report";
                    default:
                        return "NAP-Report-LOCAL";
                }
            }
        }

		public string CouchBase
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                    case SiteEnvironment.PRO:
						return "<add uri=\"http://10.40.40.22:8091/pools/default\" />";
                    case SiteEnvironment.MNL:
						return	"<add uri=\"http://10.2.98.3:8091/pools/default\" />";
                    default:
                        return "<add uri=\"http://10.35.35.253:8091/pools/default\" /> \r\n\t\t <add uri=\"http://10.35.35.253:8091/pools/default\" />";
                }
            }
        }

        public string DebugMode
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
						return "false";
                    default:
                        return "true";
                }
            }
        }

		public string ErrorMode
        {
            get
            {
                switch(Environment)
                {
				    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
						return "On";
                    default:
                        return "Off";
                }
            }
        }

        public string StateConnectionString
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.UAT:
						return "stateConnectionString=\"tcpip=10.40.40.47:42424\"";
                    case SiteEnvironment.SIT:
                        return "stateConnectionString=\"tcpip=172.16.4.107:42424\"";
                    case SiteEnvironment.PRO:
                        return "stateConnectionString=\"tcpip=10.40.40.22:42424\"";
                    case SiteEnvironment.MNL:
                        return "stateConnectionString=\"tcpip=10.2.12.10:42424\"";

                    default:
                        return "stateConnectionString=\"tcpip=ha.nexdev.net:42424\"";
                }
            }
        }

        #endregion End for Webconfig file
    }
#>