<?xml version="1.0"?>       
 
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core"/>
    <section name="LicenseeReportSection" type="Fanex.AccountingReports.Licensee.Core.Configurations.LicenseeReportSection, Fanex.AccountingReports.Licensee, Version=1.0.0.0, Culture=neutral"/>
    <section name="LicenseeEmailSection" type="Fanex.AccountingReports.Licensee.Core.Configurations.LicenseeEmailSection, Fanex.AccountingReports.Licensee, Version=1.0.0.0, Culture=neutral"/>
	  <section name="RMSection" type="Fanex.AccountingReports.Core.Configurations.RMSection, Fanex.AccountingReports.Core, Version=1.0.0.0, Culture=neutral"/>
	  <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase"/>
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core"/>
	<section name="LegendSection" type="Fanex.AccountingReports.Core.Configurations.LegendSection, Fanex.AccountingReports.Core, Version=1.0.0.0, Culture=neutral"/>
   <section name="VirtualSportsWinLossSection" type="Fanex.AccountingReports.Gaming.Core.Configurations.VirtualSportsWinLossSection.VirtualSportsWinLossSection, Fanex.AccountingReports.Gaming, Version=1.0.0.0, Culture=neutral" />
    <section name="MAMonitorSection" type="Fanex.AccountingReports.Core.Configurations.MAMonitorSection, Fanex.AccountingReports.Core, Version=1.0.0.0, Culture=neutral"/>
	<section name="SMAsTurnoverSection" type="Fanex.AccountingReports.Core.Configurations.SMAsTurnoverSection, Fanex.AccountingReports.Core, Version=1.0.0.0, Culture=neutral" />
	  <section name="TotalCreditAccountByProductSection" type="Fanex.AccountingReports.Core.Configurations.TotalCreditAccountByProductSection, Fanex.AccountingReports.Core, Version=1.0.0.0, Culture=neutral" />
	  <section name="RacingSection" type="Fanex.AccountingReports.Racing.Core.Configurations.RacingSection, Fanex.AccountingReports.Racing, Version=1.0.0.0, Culture=neutral" />
    <section name="LiveCasinoProductSection" type="Fanex.AccountingReports.Core.Configurations.LiveCasinoProductSection, Fanex.AccountingReports.Core, Version=1.0.0.0, Culture=neutral" />
	  <sectionGroup name="AuthenticationFilter">
		  <section name="Security" type="Fanex.AuthenticationFilter.Configurations.AuthenticationFilterSection, Fanex.AuthenticationFilter"/>
	  </sectionGroup>
	  
  </configSections>

	<AuthenticationFilter>
		<Security authenticateFactory="Fanex.BetList.Accounting.Authenticate.SmartPunterAttribute, Fanex.BetList.Accounting" deniedViewPath="~/Views/Common/AccessDenied.cshtml"/>
	</AuthenticationFilter>
	
	<NapSettings
    Environment="LIVE"
    IsSiteLogin="1" 
    SiteId="4"
    LBUrl="tcp://10.40.40.150:8990/UMControllerInterface"
    UM="true"
	UnauthorizeUrl="~/UserLogin/Common/AccessDenied"
    ReCheckin="true">
		<Domain>
			<add Name="58.86.55.10" Path="/AccReport"></add>
		</Domain>
	</NapSettings>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
		<add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider2,Fanex.Data" resourcePath="~/App_Data/PRO/" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
	<Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.127/msmq/Private$/entlib" defaultCategory="NAP-Report"/>
  <LicenseeReportSection configSource="Web.Configuration\LicenseeReportSection.config"/>
  <LicenseeEmailSection configSource="Web.Configuration\LicenseeEmailSection.config"/>
	<RMSection configSource="Web.Configuration\RMSection.config"/>
	<LegendSection configSource="Web.Configuration\LegendSection.config"/>
	<VirtualSportsWinLossSection configSource="Web.Configuration\VirtualSportsWinLossSection.config" />
	<MAMonitorSection configSource="Web.Configuration\MAMonitorSection.config"/>
	<SMAsTurnoverSection configSource="Web.Configuration\SMAsTurnoverSection.config"/>
	<TotalCreditAccountByProductSection configSource="Web.Configuration\TotalCreditAccountByProductSection.config"/>
	<RacingSection configSource="Web.Configuration\RacingSection.config" />
  <LiveCasinoProductSection configSource="Web.Configuration\LiveCasinoProductSection.config" />
  <couchbase>
	  <servers bucket="Nap-Report" bucketPassword="">
		  <add uri="http://10.40.40.135:8091/pools/default"/>
	  </servers>
  </couchbase>
  <connectionStrings configSource="Web.ConnectionString.config"/>
  <appSettings file="Web.AppSettings.config">
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true"/>
    <add key="webpages:Version" value="2.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="PreserveLoginUrl" value="true"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.0"/>
	  
	<customErrors mode="On" defaultRedirect="~/Views/Errors/GeneralError.htm">
      <error statusCode="404" redirect="~/Views/Errors/Error404.htm"/>
      <error statusCode="500" redirect="Error"/>
    </customErrors>
	
    <authentication mode="Forms">
		<forms cookieless="UseCookies" ticketCompatibilityMode="Framework40" loginUrl="~/UserLogin/Login" timeout="2880" defaultUrl="~/Home"/>
    </authentication>
    <!--<authorization>
            <deny users="?"/>
        </authorization>-->
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers"/>
        <add namespace="System.Web.Mvc"/>
        <add namespace="System.Web.Mvc.Ajax"/>
        <add namespace="System.Web.Mvc.Html"/>
        <add namespace="System.Web.Optimization"/>
        <add namespace="System.Web.Routing"/>
        <add namespace="System.Web.WebPages"/>
      </namespaces>
    </pages>
    <profile defaultProvider="DefaultProfileProvider">
      <providers>
        <add name="DefaultProfileProvider" type="System.Web.Providers.DefaultProfileProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" applicationName="/"/>
      </providers>
    </profile>
    <membership defaultProvider="DefaultMembershipProvider">
      <providers>
        <add name="DefaultMembershipProvider" type="System.Web.Providers.DefaultMembershipProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" enablePasswordRetrieval="false" enablePasswordReset="true" requiresQuestionAndAnswer="false" requiresUniqueEmail="false" maxInvalidPasswordAttempts="5" minRequiredPasswordLength="6" minRequiredNonalphanumericCharacters="0" passwordAttemptWindow="10" applicationName="/"/>
      </providers>
    </membership>
    <roleManager defaultProvider="DefaultRoleProvider">
      <providers>
        <add name="DefaultRoleProvider" type="System.Web.Providers.DefaultRoleProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" applicationName="/"/>
      </providers>
    </roleManager>
	  <sessionState mode="StateServer" timeout="10" stateConnectionString="tcpip=10.40.40.135:42424"  cookieless="false" />
	  <machineKey validationKey="82DD5F7E8AEE17163191F82D6E74F88716B3A834BD6D1DC5F32CB2F613222E36144B019843C69D711C8EE551F341FDFD60B1AB77F943B02A00467A0D2D632EEB"
			 decryptionKey="436E102A02B3582E206F1111DC137F5F2BFC57EBFB8ECD6736596ABDA63B9A65"
			 validation="SHA1" decryption="AES" />
    <httpHandlers>
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core"/>
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules runAllManagedModulesForAllRequests="true"/>
    <handlers>
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition=""/>
    </handlers>
	  <httpProtocol>
		  <customHeaders>
			  <add name="Access-Control-Allow-Origin" value="*"/>
		  </customHeaders>
	  </httpProtocol>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="RazorEngine" publicKeyToken="9ee697374c7e744a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.7.3.0" newVersion="3.7.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <dotless minifyCss="false" cache="true" web="false"/>
</configuration>