@using Fanex.AccountingReports.Gaming.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/MonthPicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3.css?ver=1" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less?ver=2" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Gaming/Views/NumberGameWinlossByDate/Styles/NumberGameWinlossByDate.less" />
}
@section Headline{
    <div class="title">
        <div>
            <span>@Labels.Gaming/ </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div id="NumberGameWLByDateReportFilter">
            <div class="filter-row">
                <div id="datepickerplugin" class="lbl-field col_27 align-right width-auto">
                </div>
                <div class="lbl-field col_3 align-right width-auto">
                    @Labels.Company
                </div>
                <div class="edit-field col_7 width-auto">
                    <select id="ddlSite">
                    </select>
                </div>
                <div class="lbl-field col_3 align-right width-auto">
                    @Labels.Currency
                </div>
                <div class="edit-field col_5 width-auto">
                    <select id="ddlCurrency">
                    </select>
                </div>
                <div class="lbl-field col_3 align-right width-auto">
                    @Labels.Bettype
                </div>
                <div class="edit-field col_6 ddlProductContainer width-auto">
                    <select id="ddlBettype">
                    </select>
                </div>   
                <div class="lbl-field col_4 align-right">
                    <label for="chbTrialData">
                        @Labels.TrialData
                    </label>
                    <input type="checkbox" id="checkbox-trialdata" class="checkbox-trialdata" />
                </div>             
                <div class="submit width-auto col_4 prefix_1">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="numberGameWLByDateGrid" class="display-none content-grid width-100percent">
    <div id="numberGameWLByDateMainGrid" class="freegrid">
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var noteMessage = '@Html.Raw(GamingResources.WinLossByLicensee_FilterNote)';
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@(new DateTime(2010, 11, 1).ToShortDateString())';
        var yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
    </script>
}
@section Foot
{
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker")
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/NumberGameWinlossByDate/Scripts/NumberGameWinlossByDate.js?ver=1"></script>
}
