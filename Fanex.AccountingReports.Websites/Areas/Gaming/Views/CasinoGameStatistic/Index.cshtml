@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Gaming.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Gaming.Constants;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Autocomplete/styles.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Gaming/Views/CasinoGameStatistic/Styles/CasinoGameStatistic.less" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Gaming / </span><span class="curr">@ViewBag.Title</span>
            <div class="showHideFilter expanded" title="@Labels.Hide_filter">
            </div>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right bold">
                    @Labels.Search_by
                </div>
                 <div class="lbl-field col_5 align-right">
                    @Labels.Product
                </div>
                <div class="edit-field col_6">
                    <select id="ddl-product" class="ddl-product">
                        <option value="0">All</option>
                        <option value="4">SLI</option>
                        <option value="12">Gold Deluxe</option>
                        <option value="13">Microgaming</option>
                        <option value="11">AG Casino</option>
                    </select>
                </div>   
                <div class="lbl-field col_5 align-left">
                    @Labels._3rdParty
                </div>   
                <div class="edit-field col_6">
                    <select id="ddl-3rd" class="ddl-product">
                    </select>
                </div>          
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="edit-field col_4"></div>
                <div id="datepickerplugin" class="lbl-field col_27 align-right"></div>
            </div>
        </div>

        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right bold">
                    @Labels.User_search
                </div>
                <div class="lbl-field col_3 prefix_2 align-right">
                    @Labels.UserName
                </div>
                <div class="col_6">
                    <input id="txtUserName" type="text" maxlength="50" value="@Labels.Search_All" class="defaultSuggestionBox" />
                </div>
                <div class="lbl-field col_6 align-left width125">
                    <input id="exclude-test-data" type="checkbox" class="alpha" checked="checked" />
                    <label for="exclude-test-data">
                        @Labels.Exclude_Test_Data</label>
                </div>
                <div class="lbl-field col_6 align-left width150">
                    <input id="show-refund-column" type="checkbox" class="alpha" />
                    <label for="show-refund-column">
                        @Labels.Show_refund_column</label>
                </div>
                <div class="lbl-field col_3 align-left width71">
                    @Labels.Currency
                </div>
                <div class="edit-field col_6">
                    <select id="dropdown-currency" class="dropdown-currency">
                    </select>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right bold">
                    @Labels.Game_search
                </div>
                <div class="lbl-field col_3 prefix_2 align-right">
                    @Labels.Company
                </div>
                <div class="edit-field col_6">
                    <select id="dropdown-company" class="dropdown-company">
                    </select>
                </div>
                <div class="lbl-field col_5 align-left">
                    @Labels.Game_type
                </div>
                <div class="edit-field col_9">
                    <select id="dropdown-gametype" class="dropdown-gametype">
                    </select>
                </div>
                <div id="game-table-container" class="col_10">
                    <div class="lbl-field col_3 align-left">
                        @Labels.Game_table
                    </div>
                    <div class="edit-field col_6">
                        <select id="dropdown-gametable" class="dropdown-gametable">
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_5 prefix_4 align-right">
                    @Labels.Total_bet_less_than
                </div>
                <div class="edit-field col_6">
                    <input id="txt-totalbet-lessthan" type="text" maxlength="9" class="format-numberonly" />
                </div>
                <div class="lbl-field col_5 align-left">
                    @Labels.Total_bet_more_than
                </div>
                <div class="edit-field col_6">
                    <input id="txt-totalbet-morethan" type="text" maxlength="9" class="format-numberonly" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_5 prefix_4 align-right">
                    @Labels.Total_win_less_than
                </div>
                <div class="edit-field col_6">
                    <input id="txt-totalwin-lessthan" type="text" maxlength="9" class="format-numberonly" />
                </div>
                <div class="lbl-field col_5 align-left">
                    @Labels.Total_win_more_than
                </div>
                <div class="edit-field col_6">
                    <input id="txt-totalwin-morethan" type="text" maxlength="9" class="format-numberonly" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right bold">
                    @Labels.Report_by
                </div>
                <div id="reportBy" class="lbl-field col_29 prefix_5 align-left">
                    <div class="col_3 alpha">
                        <input type="radio" name="rdReportBy" id="rdReportByDaily" value="@PeriodTypeConstants.LiveCasinoGameStatisticDaily" />
                        <label for="rdReportByDaily">
                            @Labels.Daily</label></div>
                    <div class="col_3">
                        <input type="radio" name="rdReportBy" id="rdReportByMonthly" value="@PeriodTypeConstants.LiveCasinoGameStatisticMonthly" />
                        <label for="rdReportByMonthly">
                            @Labels.Monthly</label></div>
                    <div class="col_4">
                        <input type="radio" name="rdReportBy" id="rdReportByUsername" value="@PeriodTypeConstants.LiveCasinoGameStatisticUsername" />
                        <label for="rdReportByUsername">
                            @Labels.UserName</label></div>
                    <div class="col_4">
                        <input type="radio" name="rdReportBy" id="rdReportByGameType"  checked="checked" value="@PeriodTypeConstants.LiveCasinoGameStatisticGameType" />
                        <label for="rdReportByGameType">
                            @Labels.Game_type</label></div>
                    <div id="rdGameTableContainer" class="col_4">
                        <input type="radio" name="rdReportBy" id="rdReportByGameTable" value="@PeriodTypeConstants.LiveCasinoGameStatisticGameTable" />
                        <label for="rdReportByGameTable">
                            @Labels.Game_table</label></div>
                    <div class="col_4">
                        <input type="radio" name="rdReportBy" id="rdReportByCompany" value="@PeriodTypeConstants.LiveCasinoGameStatisticCompany" />
                        <label for="rdReportByCompany">
                            @Labels.Company</label></div>
                    <div class="col_4">
                        <input type="radio" name="rdReportBy" id="rdReportByCurrency" value="@PeriodTypeConstants.LiveCasinoGameStatisticCurrency" />
                        <label for="rdReportByCurrency">
                            @Labels.Currency</label></div>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="submit width-auto col_4 prefix_9">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="@Labels.Generate" />
                    <input id="btnToday" name="btnToday" type="submit" value="@Labels.Today" />
                    <input id="btnYesterday" name="btnYesterday" type="submit" value="@Labels.Yesterday" />
                   @* <div id="button-export" class="export-excel-div-button" title="Export to Excel">
                        <div class="export-excel-icon">
                        </div>
                        <div class="export-excel-label">
                            @Labels.Export</div>
                    </div>*@
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="mainLiveCasinoGameStatisticReportContainer">
        <div id="mainLiveCasinoGameStatisticReport" class="freegrid display-none">
        </div>
    </div>
    <div id="hourlyReportContainer">
        <div id="hourlyReport" class="freegrid display-none">
        </div>
    </div>
    <div id="grandTotalContainer">
        <div id="grandTotal" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var today = '@DateTime.Today.ToShortFormatedDate()';
        var yesterday = '@DateTime.Today.AddDays(-1).ToShortFormatedDate()';
        var minDate = '@DateTime.Today.AddMonths(-6).FirstDayOfMonth().ToShortFormatedDate()';
        var beginLast3Months = '@DateTime.Today.AddMonths(-3).FirstDayOfMonth().ToShortFormatedDate()';
        var endLast3Months = '@DateTime.Today.AddMonths(-1).LastDayOfMonth().ToShortFormatedDate()';
        var beginLast6Months = '@DateTime.Today.AddMonths(-6).FirstDayOfMonth().ToShortFormatedDate()';
        var endLast6Months = '@DateTime.Today.AddMonths(-1).LastDayOfMonth().ToShortFormatedDate()';
        var viewResources = {
            Time_period: '@Labels.Time_period',
            From_Date: '@Labels.From_Date',
            To_Date: '@Labels.To_Date',
            Options_LastMonthRange: '@Labels.Options_LastMonthRange',
            Hide_filter: '@Labels.Hide_filter',
            Show_filter: '@Labels.Show_filter',
            All: '@Labels.All',
            Search_All: '@Labels.Search_All',
            No_company_found: '@Labels.No_company_found',
            All_Companies: '@Labels.All_Companies',
            UserName: '@Labels.UserName',
            Currency: '@Labels.Currency',
            Total_bets: '@Labels.Total_Bets',
            Total_wins: '@Labels.Total_Wins',
            Game_income: '@Labels.Game_income',
            Game_payout: '@Labels.Game_payout',
            Company_comm: '@Labels.Company_comm',
            Company_net_income: '@Labels.Company_net_income',
            No_Players: '@Labels.No_Players',
            Company: '@Labels.Company',
            Date: '@Labels.Date',
            Month: '@Labels.Month',
            CasinoGameStatistic_ReportTitle: '@GamingResources.CasinoGameStatistic_ReportTitle',
            CasinoGameStatisticOnDateByCurrency_ReportTitle: '@GamingResources.CasinoGameStatisticOnDateByCurrency_ReportTitle',
            All_Currencies: '@Labels.All_Currencies',
            Error_NoCurrencyFound: '@Labels.Error_NoCurrencyFound',
            All: '@Labels.All',
            Error_LiveCasinoGameStatistic_BetLess_LessThan_BetMore: '@GamingResources.Error_LiveCasinoGameStatistic_BetLess_LessThan_BetMore',
            Error_LiveCasinoGameStatistic_WinLess_LessThan_WinMore: '@GamingResources.Error_LiveCasinoGameStatistic_WinLess_LessThan_WinMore',
            No_Games: '@Labels.No_Games',
            Bet_Count: '@Labels.Bet_Count',
            Company_Turnover: '@Labels.Company_Turnover',
            Total_refund: '@Labels.Total_refund',
            Game: '@Labels.Game',
            CustId: '@Labels.CustId',
            Table: '@Labels.Table'
        };
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.setcaretposition.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.caret.1.02.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.formattyping.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Autocomplete/jquery.autocomplete.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MultipleSelect/jquery.multiselect.nlevel.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/PopUp/dialogbox.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByUserName.js?v=1"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByCurrency.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByGameType.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByGameTable.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByCompany.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByDailyRange.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportDailyByCurrency.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByMonthlyRange.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportMonthlyByCurrency.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByMonthlyToDailyRange.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByGrandTotal.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportByHourly.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/CasinoGameStatistic/Scripts/ReportManager.js?v=1"></script>
    
}
