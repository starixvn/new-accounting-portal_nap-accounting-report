@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Gaming.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Gaming.Constants;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Autocomplete/styles.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Gaming/Views/BingoStatistic/Styles/BingoStatistic.less">
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Gaming / </span><span class="curr">@ViewBag.Title</span>
            <div class="showHideFilter expanded" title="@Labels.Hide_filter">
            </div>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right bold">
                    @Labels.Search_by
                </div>
                <div id="datepickerplugin" class="lbl-field col_27 align-right">
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right bold">
                    @Labels.User_search
                </div>
                <div class="lbl-field col_3 prefix_1 align-right">
                    @Labels.UserName
                </div>
                <div class="col_7">
                    <input id="txtUserName" type="text" maxlength="50" value="@Labels.Search_All" class="defaultSuggestionBox" />
                </div>
                <div class="lbl-field col_6 align-left">
                    <input id="exclude-test-account" type="checkbox" class="alpha" checked="checked" />
                    <label for="exclude-test-account">
                        @Labels.Exclude_test_accounts</label>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right bold">
                    @Labels.Game_search
                </div>
                <div class="lbl-field col_3 prefix_1 align-right">
                    @Labels.Company
                </div>
                <div class="edit-field col_7">
                    <select id="dropdownCompany" class="dropdownCompany">
                    </select>
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.Currency
                </div>
                <div class="edit-field col_7">
                    <select id="dropdownCurrency" class="dropdownCurrency">
                    </select>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right bold">
                    @Labels.Report_by
                </div>
                <div id="reportBy" class="lbl-field col_21 prefix_4 align-left">
                    <div class="col_3 alpha">
                        <input type="radio" name="rdReportBy" id="rdReportByDaily" checked="checked" value="@PeriodTypeConstants.GamingBingoStatisticDaily" />
                        <label for="rdReportByDaily">
                            @Labels.Daily</label></div>
                    <div class="col_3">
                        <input type="radio" name="rdReportBy" id="rdReportByMonthly" value="@PeriodTypeConstants.GamingBingoStatisticMonthly" />
                        <label for="rdReportByMonthly">
                            @Labels.Monthly</label></div>
                    <div class="col_4">
                        <input type="radio" name="rdReportBy" id="rdReportByUsername" value="@PeriodTypeConstants.GamingBingoStatisticUsername" />
                        <label for="rdReportByUsername">
                            @Labels.User_Name</label></div>
                    <div class="col_4">
                        <input type="radio" name="rdReportBy" id="rdReportByCompany" value="@PeriodTypeConstants.GamingBingoStatisticCompany" />
                        <label for="rdReportByCompany">
                            @Labels.Company</label></div>
                    <div class="col_4">
                        <input type="radio" name="rdReportBy" id="rdReportByCurrency" value="@PeriodTypeConstants.GamingBingoStatisticCurrency" />
                        <label for="rdReportByCurrency">
                            @Labels.Currency</label></div>
                    <div class="col_3 omega">
                        <input type="radio" name="rdReportBy" id="rdReportByAgent" value="@PeriodTypeConstants.GamingBingoStatisticAgent" />
                        <label for="rdReportByAgent">
                            @Labels.Agent</label></div>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="submit width-auto col_4 prefix_8">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="@Labels.Generate" />
                    <input id="btnToday" name="btnToday" type="submit" value="@Labels.Today" />
                    <input id="btnYesterday" name="btnYesterday" type="submit" value="@Labels.Yesterday" />
                    <div id="btnExport" class="export-excel-div-button" title="Export to Excel">
                        <div class="export-excel-icon">
                        </div>
                        <div class="export-excel-label">
                            @Labels.Export</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="mainBingoStatisticReportContainer">
        <div id="mainBingoStatisticReport" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var today = '@DateTime.Today.ToShortFormatedDate()';
        var yesterday = '@DateTime.Today.AddDays(-1).ToShortFormatedDate()';
        var minDate = '@DateTime.Today.AddMonths(-3).FirstDayOfMonth().ToShortFormatedDate()';
        var beginLast3Months = '@DateTime.Today.AddMonths(-3).FirstDayOfMonth().ToShortFormatedDate()';
        var endLast3Months = '@DateTime.Today.AddMonths(-1).LastDayOfMonth().ToShortFormatedDate()';
        var viewResources = {
            Time_period: '@Labels.Time_period',
            From_Date: '@Labels.From_Date',
            To_Date: '@Labels.To_Date',
            Options_LastMonthRange: '@Labels.Options_LastMonthRange',
            Hide_filter: '@Labels.Hide_filter',
            Show_filter: '@Labels.Show_filter',
            All: '@Labels.All',
            Search_All: '@Labels.Search_All',
            No_company_found: '@Labels.No_company_found',
            All_Companies: '@Labels.All_Companies',
            UserName: '@Labels.UserName',
            Currency: '@Labels.Currency',
            Outstanding: '@Labels.Outstanding',
            Total_bets: '@Labels.Total_Bets',
            Total_wins: '@Labels.Total_Wins',
            Game_income: '@Labels.Game_income',
            Game_payout: '@Labels.Game_payout',
            Company_comm: '@Labels.Company_comm',
            Company_net_income: '@Labels.Company_net_income',
            No_Players: '@Labels.No_Players',
            Agent: '@Labels.Agent',
            Company: '@Labels.Company',
            Date: '@Labels.Date',
            Month: '@Labels.Month',
            BingoStatistic_ReportTitle: '@GamingResources.BingoStatistic_ReportTitle'
        }; 
    </script>
}
@section Foot {
    @Scripts.Render("~/scripts/_lib/multiselect")
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Autocomplete/jquery.autocomplete.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/BingoStatistic/Scripts/ReportManager.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/BingoStatistic/Scripts/ReportByUserName.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/BingoStatistic/Scripts/ReportByCurrency.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/BingoStatistic/Scripts/ReportByAgent.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/BingoStatistic/Scripts/ReportByCompany.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/BingoStatistic/Scripts/ReportByDailyRange.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/BingoStatistic/Scripts/ReportByMonthlyRange.js"></script>
}
