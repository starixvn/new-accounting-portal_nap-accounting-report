@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Gaming.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render(
        "~/scripts/_lib/MultipleSelect/style",
        "~/scripts/_lib/MonthPicker/style",
        "~/scripts/_lib/DatePicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less?ver=2" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Gaming/Views/NumberGameWinLossByBetTypeMatch/Styles/NumberGameWinLossByBetTypeMatch.less" />
}
@section Headline{
    <div class="title">
        <div>
            <span>@Labels.Gaming/ </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_3 align-right">
                @Labels.Report_by
            </div>
            <div class="edit-field col_6 align-left">
                <select id="dropdown-reportby" class="alpha">
                    <option value="1">@Labels.Bet_Type</option>
                    <option value="2">@Labels.Match</option>
                </select>
            </div>
            <div id="datepickerplugin" class="lbl-field col_7 align-right width-auto">
            </div>
            <div class="lbl-field col_3 align-right width-auto">
                @Labels.Company
            </div>
            <div class="edit-field col_7 width-auto">
                <select id="dropdown-company"></select>
            </div>
            <div class="lbl-field col_3 align-right width-auto">
                @Labels.Currency
            </div>
            <div class="edit-field col_5 width-auto">
                <select id="dropdown-currency"></select>
            </div>
            <div class="lbl-field col_3 align-right width-auto winloss-bybettype-filter">
                @Labels.Live_Status
            </div>
            <div class="edit-field col_6 width-auto winloss-bybettype-filter">
                <select id="dropdown-livestatus">
                    <option value="-1">@Labels.All</option>
                    <option value="0">@Labels.None_live</option>
                    <option value="1">@Labels.Live</option>
                </select>
            </div>
            <div class="lbl-field col_3 align-right width-auto  winloss-bymatch-filter display-none">
                @Labels.Bettype
            </div>
            <div class="edit-field col_6 ddlProductContainer width-auto winloss-bymatch-filter display-none">
                <select id="dropdown-bettype"></select>
            </div>
            <div class="lbl-field col_4 align-right">
                <label for="chbTrialData">
                    @Labels.TrialData
                </label>
                <input type="checkbox" id="checkbox-trialdata" class="checkbox-trialdata" />
            </div>
            <div class="submit width-auto col_4 prefix_1">
                <input id="button-generate" name="btnGenerate" type="submit" value="@Labels.Generate" />
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="winloss-bybettype-container" class="display-none content-grid width-100percent">
        <div id="winloss-bybettype-grid" class="freegrid">
        </div>
    </div>
    <div id="winloss-bybettype-detail-container" class="display-none content-grid width-100percent">
        <div id="winloss-bybettype-detail-grid" class="freegrid">
        </div>
    </div>
    <div id="winloss-bymatch-container" class="display-none content-grid width-100percent">
        <div id="winloss-bymatch-grid" class="freegrid">
        </div>
    </div>
    <div id="winloss-bymatch-detail-container" class="display-none content-grid width-100percent">
        <div id="winloss-bymatch-detail-grid" class="freegrid">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var today = '@DateTime.Today.ToShortDateString()';
        var yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var minDateWinLossByBetType = '@((new DateTime(2010, 11, 1)).ToShortDateString())';
        var minDateWinLossByMatch = '@((new DateTime(2010, 11, 1)).ToShortDateString())';
        var viewResources = {
            IBC_Group: '@Labels.IBC_Group',
            Licensee: '@Labels.Licensee',
            All_Licensees: '@Labels.All_Licensees',
            All_Currencies: '@Labels.All_Currencies',
            All_Bet_Types: '@Labels.All_Bet_Types',
            Error_NoLicenseeFound: '@Labels.Error_NoLicenseeFound',
            Error_NoCurrencyFound: '@Labels.Error_NoCurrencyFound',
            Error_NoBetTypeFound: '@Labels.Error_NoBetTypeFound',
            Date: '@Labels.Date',
            Bet_Type: '@Labels.Bet_Type',
            Customer_Win_Loss: '@Labels.Customer_Win_Loss',
            Agency_Win_Loss: '@Labels.Agency_Win_Loss',
            Commission: '@Labels.Commission',
            Line_Total: '@Labels.Line_Total',
            Virtual_Line_Total: '@Labels.Virtual_Line_Total',
            Variance: '@Labels.Variance',
            Turnover: '@Labels.Turnover',
            Margin: '@Labels.Margin',
            Company: '@Labels.Company',
            NumberGameWinLossByBetTypeMatch_ByBetTypeMainReportTitle: '@GamingResources.NumberGameWinLossByBetTypeMatch_ByBetTypeMainReportTitle',
            NumberGameWinLossByBetTypeMatch_ByBetTypeDetailReportTitle: '@GamingResources.NumberGameWinLossByBetTypeMatch_ByBetTypeDetailReportTitle',
            NotAvailable: '@Labels.NotAvailable',
            Match: '@Labels.Match',
            NumberGameWinLossByBetTypeMatch_ByMatchMainReportTitle: '@GamingResources.NumberGameWinLossByBetTypeMatch_ByMatchMainReportTitle',
            Symbol_No: '@Labels.Symbol_No',
            User_Name: '@Labels.User_Name',
            Company_Turnover: '@Labels.Company_Turnover',
            Gross_Comm: '@Labels.Gross_Comm',
            Customer: '@Labels.Customer',
            Agent: '@Labels.Agent',
            Master: '@Labels.Master',
            Super: '@Labels.Super',
            Win_Loss: '@Labels.Win_Loss',
            Total: '@Labels.Total'
        };
    </script>
}
@section Foot
{
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker")
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/NumberGameWinLossByBetTypeMatch/Scripts/WinLossByBetType.js?v=3"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/NumberGameWinLossByBetTypeMatch/Scripts/WinLossByBetTypeMainReport.js?v=3"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/NumberGameWinLossByBetTypeMatch/Scripts/WinLossByBetTypeDetailReport.js?v=3"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/NumberGameWinLossByBetTypeMatch/Scripts/WinLossByMatch.js?v=3"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/NumberGameWinLossByBetTypeMatch/Scripts/WinLossByMatchMainReport.js?v=3"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/NumberGameWinLossByBetTypeMatch/Scripts/WinLossByMatchDetailReport.js?v=3"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/NumberGameWinLossByBetTypeMatch/Scripts/ReportManager.js?v=3"></script>
}
