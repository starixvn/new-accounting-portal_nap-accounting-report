@using Fanex.AccountingReports.Gaming.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/MonthPicker/style", "~/scripts/_lib/Fanex.Grid/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3.css?ver=1" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less?ver=2" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Gaming/Views/NumberGameWinLossByCurrency/Styles/NumberGameWinlossByCur.less" />
}
@section Headline{
    <div class="title">
        <div>
            <span>@Labels.Gaming/ </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div id="NumberGameWLByDateReportFilter">
            <div class="filter-row">
                <div id="datepickerplugin" class="lbl-field col_27 align-right">
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.Live_Status
                </div>
                <div class="edit-field col_6 ddlProductContainer">
                    <select id="ddlLiveStatus">
                        <option value="-1">All</option>
                        <option value="1">Live</option>
                        <option value="0">Non-Live</option>
                    </select>
                </div>
                <div class="lbl-field col_4 align-right"">
                 <label for="chbShowComm">
                        @Labels.Show_Comm</label>
                    <input type="checkbox" id="checkbox-showcommision" class="checkbox-showcommision"/>
                </div>                
            </div>
            <div class="filter-row">
                <div class="lbl-field col_3 align-right">
                    @Labels.Company
                </div>
                <div class="edit-field col_7">
                    <select id="ddlSite">
                    </select>
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.Currency
                </div>
                <div class="edit-field col_5">
                    <select id="ddlCurrency">
                    </select>
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.Bettype
                </div>
                <div class="edit-field col_6 ddlProductContainer">
                    <select id="ddlBettype">
                    </select>
                </div>
                <div class="lbl-field col_4 align-right">
                    <label for="chbTrialData">
                        @Labels.TrialData
                    </label>
                    <input type="checkbox" id="checkbox-trialdata" class="checkbox-trialdata" />
                </div>
                <div class="submit width-auto col_4 prefix_1">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
            
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="numberGameWLByDateGrid" class="display-none content-grid width-100percent">
    <div id="numberGameWLByDateMainGridContainer">
        <div id="numberGameWLByDateMainGrid" class="freegrid">
        </div>
    </div>
    <div id="numberGameWLByDateMainGrid_CurrencyContainer">
        <div id="numberGameWLByDateMainGrid_Currency" class="freegrid">
        </div>
    </div>
    <div id="numberGameWLByDateMainGrid_SuperContainer">
        <div id="numberGameWLByDateMainGrid_Super" class="freegrid">
        </div>
    </div>
    <div id="numberGameWLByDateMainGrid_MasterContainer">
        <div id="numberGameWLByDateMainGrid_Master" class="freegrid">
        </div>
    </div>
    <div id="numberGameWLByDateMainGrid_AgentContainer">
        <div id="numberGameWLByDateMainGrid_Agent" class="freegrid">
        </div>
    </div>
    <div id="numberGameWLByDateMainGrid_MemberContainer">
        <div id="numberGameWLByDateMainGrid_Member" class="freegrid">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var noteMessage = '@Html.Raw(GamingResources.WinLossByLicensee_FilterNote)';
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@(new DateTime(2010, 11, 1).ToShortDateString())';
        var yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
    </script>
}
@section Foot
{
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker")
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/NumberGameWinLossByCurrency/Scripts/NumberGameWinlossByCur.js?v=1"></script>
}
