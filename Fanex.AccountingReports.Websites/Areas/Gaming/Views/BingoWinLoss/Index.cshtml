@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Gaming.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Services.Impl;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Gaming/Views/BingoWinLoss/Styles/BingoWinLoss.less">
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Gaming / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_15 align-right">
                </div>
            </div>
            <div class="submit col_4">
                <input id="btnGenerate" name="btnGenerate" type="submit" value="@Labels.Generate" />
            </div>
            <div class="submit col_4">
                <input id="btnExport" name="btnExport" type="submit" value="@Labels.Export" />
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="bingoReportContainer">
        <div id="bingoReport" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var today = '@DateTime.Today.ToShortDateString()';
        var yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var minDate = '@DateTime.Today.AddMonths(-3).ToShortDateString()';
        var viewResources = {
            To: '@Labels.To',
            From: '@Labels.From',
            Bet_Type: '@Labels.Bet_Type',
            Currency: '@Labels.Currency',
            Turnover: '@Labels.Turnover',
            Win_Loss: '@Labels.Win_Loss',
            Position: '@Labels.Position',
            Commission: '@Labels.Commission',
            Line_Total: '@Labels.Line_Total',
            BingoWinLoss_ReportTitle: '@GamingResources.BingoWinLoss_ReportTitle'
        };
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/Areas/Gaming/Views/BingoWinLoss/Scripts/ReportManager.js"></script>
}
