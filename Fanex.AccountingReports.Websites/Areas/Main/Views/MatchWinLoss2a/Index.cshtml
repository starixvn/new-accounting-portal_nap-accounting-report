@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Main.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Configurations;
@using Fanex.AccountingReports.Core;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Main/Views/MatchWinLoss2a/Styles/MatchWinLoss2a.less" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Main / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_7 align-right">
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" class="" />
                    <input id="btnToday" name="btnToday" type="submit" value="Today" class="" />
                    <input id="btnYesterday" name="btnYesterday" type="submit" value="Yesterday" class="" />
                    <input id="btnExport" name="btnExport" type="submit" value="EXPORT" class="" disabled="disabled" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell main-report-filter-wrap">
                <div>
                    <input type="checkbox" id="chkMainReport" checked="checked" value="Main Report"/>
                    <label for="chkMainReport">Main Report</label>
                </div>
            </div>
            <div class="filter-cell">
                <div>
                    <input type="checkbox" id="chkDetailReport" checked="checked" value="Detail Report"/>
                    <label for="chkDetailReport">Detail Report</label>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="summaryReportByBetTypeContainer" class="font-size-12">
        <div id="summaryReportByBetType" class="freegrid display-none">
        </div>
    </div>
    <div id="summaryReportBySportTypeContainer" class="font-size-12">
        <div id="summaryReportBySportType" class="freegrid display-none">
        </div>
    </div>
    <div id="detailReportByBetTypeContainer" class="display-none font-size-12">
        <div id="detaiReportByBetType" class="freegrid display-none">
        </div>
    </div>
    <div id="detailReportBySportsTypeContainer" class="display-none font-size-12">
        <div id="detaiReportBySportsType" class="freegrid display-none">
        </div>
    </div>
    <div id="thirdPartyReportContainer" class="display-none font-size-12">
        <div id="thirdPartyReport" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var labelDate = '@Labels.Date';
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';
        var yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var shortFormattedYesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var shortFormattedToday = '@DateTime.Today.ToShortDateString()';
        var minDate = '@(new DateTime(2006, 1, 1).ToShortDateString())';
        var beginSupportMPDate = '@AppSettings.MixParlayAdvanceSupportDate.ToShortDateString()';
        var balanceUpDay = '@(ReportService.BalanceUp.BalanceUpDay.ToShortDateString())';
        var totalTitle = '@Labels.Total';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/PopUp/dialogbox.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/MatchWinLoss2a/Scripts/SummaryReportByBetType.js?v=3"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/MatchWinLoss2a/Scripts/SummaryReportBySportType.js?v=3"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/MatchWinLoss2a/Scripts/DetailReportByBetType.js?v=3"></script>
     <script type="text/javascript" src="~/Areas/Main/Views/MatchWinLoss2a/Scripts/DetailReportBySportsType.js?ver=1"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/MatchWinLoss2a/Scripts/ThirdPartyDetailReport.js?ver=1"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/MatchWinLoss2a/Scripts/ReportManager.js?ver=1"></script>
}
