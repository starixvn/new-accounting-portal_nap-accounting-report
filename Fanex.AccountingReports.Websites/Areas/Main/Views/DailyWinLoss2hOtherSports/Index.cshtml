@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Main.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Configurations;
@using Fanex.AccountingReports.Core;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Core.Constants;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ?
        AppSession.CurrentWorkingOnMenu.Name :
        string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Styles/DailyWinLoss2h.less" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Main / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_7 align-right">
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="@Labels.Generate" />
                    <input id="btnToday" name="btnToday" type="submit" value="@Labels.Today" />
                    <input id="btnYesterday" name="btnYesterday" type="submit" value="@Labels.Yesterday" />
                    <input id="btnExport" name="btnExport" type="submit" value="@Labels.Export" title="@Labels.Export" disabled="disabled" />
                    <input id="btnShowHideSiteTypeInfo" name="btnShowHideSiteTypeInfo" type="submit" value="@Labels.Expand" title="@Labels.Collapse/@Labels.Expand" disabled="disabled" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="errMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    @Html.Partial("~/Areas/Main/Views/DailyWinLoss2hOtherSports/Main2hReport.cshtml")
    @Html.Partial("~/Areas/Main/Views/DailyWinLoss2hOtherSports/OtherSportReport.cshtml")
    @Html.Partial("~/Areas/Main/Views/DailyWinLoss2hOtherSports/WinLossBySite_BetType.cshtml")
    @Html.Partial("~/Areas/BetList/Views/ScoreInformation/ScoreInformation.cshtml")
</div>
@section scripts
{
    <script type="text/javascript">
        var today = '@DateTime.Today.ToShortDateString()';
        var shortFormattedYesterday = '@DateTime.Today.AddDays(-1).ToShortFormatedDate()';
        var shortFormattedToday = '@DateTime.Today.ToShortFormatedDate()';
        var minDate = '@(new DateTime(2011, 1, 1).ToShortFormatedDate())';
        var beginSupportAdvanceMixParlayDate = '@AppSettings.MixParlayAdvanceSupportDate';
        var balanceUpDay = '@ReportService.BalanceUp.BalanceUpDay';
        var is8RMActive = '@(RMSection.Instance.Report[ReportName.DailyWinLoss2h.ToString()].ReportConfigs[RMSection.RMType.EightRM.ToString()].IsActive)'.toLowerCase();
        var isBARMActive = '@(RMSection.Instance.Report[ReportName.DailyWinLoss2h.ToString()].ReportConfigs[RMSection.RMType.BARM.ToString()].IsActive)'.toLowerCase();
        var viewResources = {
            Date: '@Labels.Date',
            Sport_Type: '@Labels.Sport_Type',
            Win_Loss: '@Labels.Win_Loss',
            Position: '@Labels.Position',
            Commission: '@Labels.Commission',
            Line_Total: '@Labels.Line_Total',
            Turnover: '@Labels.Turnover',
            Margin: '@Labels.Margin',
            Bet_Type: '@Labels.Bet_Type',
            Code: '@Labels.Code',
            Event: '@Labels.Event',
            Real: '@Labels.Real',
            Virtual: '@Labels.Virtual',
            Variance: '@Labels.Variance',
            IBC: '@Labels.IBC',
            _8RM: '@Labels.EightRM',
            BARM: '@Labels.BARM',
            Total: '@Labels.Total',
            Main: '@Labels.Main',
            Bet_Type: '@Labels.Bet_Type',
            Live: '@Labels.Live',
            Non_Live: '@Labels.Non_Live',
            Symbol_Sparse_Non_Live: '@Labels.Symbol_Sparse_Non_Live',
            Show_Score_Information: '@Labels.Show_Score_Information',
            Symbol_NeutralSuffix: '@Labels.Symbol_NeutralSuffix',
            NotAvailable: '@Labels.NotAvailable',
            Site: '@Labels.Site',
            Credit_Site: '@Labels.Credit_Site',
            Deposit_Site: '@Labels.Deposit_Site',
            All_Sites: '@Labels.All_Sites',
            Expand: '@Labels.Expand',
            Collapse: '@Labels.Collapse',
            EmptyReportMessage: '@Labels.EmptyReportMessage',
            DailyWinLoss2h_Main2hReport_Title: '@MainResources.DailyWinLoss2h_Main2hReport_Title',
            DailyWinLoss2h_OtherSportReport_MainReport_Title: '@MainResources.DailyWinLoss2h_OtherSportReport_MainReport_Title',
            DailyWinLoss2h_ReportTitleSuffix: '@MainResources.DailyWinLoss2h_ReportTitleSuffix',
            DailyWinLoss2h_WinLossBySite_BetType_ReportTitle: '@MainResources.DailyWinLoss2h_WinLossBySite_BetType_ReportTitle',
            Member_WinLoss: '@Labels.Member_Win_Loss',
            SMA_WinLoss: '@Labels.SMA_Win_Loss',
            Company_Income: '@Labels.Company_Income',
            Company_Turnover: '@Labels.Company_Turnover'
        };
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/PopUp/dialogbox.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Scripts/Main2hReport.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Scripts/OtherSportReport_Summary.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Scripts/OtherSportReport_BySportType.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Scripts/OtherSportReport_ByBetType.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Scripts/OtherSportsForNewCricket.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Scripts/OtherSportReport.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Scripts/WinLossBySite_BetType.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2h/Scripts/ShowHideSiteTypeManager.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Scripts/ReportManager.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/DailyWinLoss2hOtherSports/Scripts/ShowHideReportManager.js"></script>
}
