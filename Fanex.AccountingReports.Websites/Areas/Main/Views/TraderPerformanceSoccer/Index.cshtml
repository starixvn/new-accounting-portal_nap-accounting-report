@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Main.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Configurations;
@using Fanex.AccountingReports.Core;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Core.Constants;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Main/Views/TraderPerformanceSoccer/Styles/TraderPerformanceSoccer.less?v=1" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Main / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_15 align-right">
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="@Labels.Generate" class="col_4 alpha" />
                    <input id="btnDetailReport" name="btnDetailReport" type="submit" value="@Labels.Detail" class="col_4 omega" />
                    <input id="btnSummarylReport" name="btnSummarylReport" type="submit" value="@Labels.Summary" class="col_4 omega display-none" />
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    @Html.Partial("_TraderPerformanceMainReport")
    @Html.Partial("_TraderPerformanceDetailReport")
</div>
@section scripts
{
    <script type="text/javascript">
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@ReportService.BalanceUp.MoveBetsDay.AddDays(1).ToShortDateString()';
        var grandTotal = '@Labels.Grand_Total';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/PopUp/dialogbox.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/TraderPerformanceSoccer/Scripts/TraderPerformanceSoccer.js"></script>
}
