@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Main.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Services.Impl;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/MonthPicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Main/Views/WinLossSummary3rd/Styles/WinLossSummary.less">
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Main / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div id="filter-form" class="filter-form">
        <div id="winlossSummaryReportFilter">
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="datepickerplugin" class="lbl-field col_15 align-right">
                    </div>
                </div>
                <div class="submit col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="@Labels.Generate" />
                </div>
				<div class="submit col_4">
                    <input id="btnHistoryReport" name="btnHistoryReport" type="submit" value="@Labels.History_Report" />
                </div>
                <div class="submit" style="margin-left: 40px">
                    <input id="btnShowHideSiteTypeInfo" name="btnShowHideSiteTypeInfo" type="submit" value="@Labels.Expand" title="@Labels.Collapse/@Labels.Expand" disabled="disabled"/>
                </div>
            </div>
        </div>
		<div id="winlossSummaryReportFilter-history" class="">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_2">
                        <div>@Labels.Month</div>
					</div>
					<div class="edit-field col_15">
						<div id="ddlMonth"></div>
					</div>
				</div>
                <div class="submit col_4">
                    <input id="btnGenerate-history" name="btnGenerate-history" type="submit" value="@Labels.Generate" />
                </div>
				<div class="submit col_4">
                    <input id="btnBack" name="btnBack" type="submit" value="@Labels.Back" />
                </div>
                <div class="submit col_4">
                    <input id="btnShowHideSiteTypeInfoHistory" name="btnShowHideSiteTypeInfoHistory" type="submit" value="@Labels.Expand" title="@Labels.Collapse/@Labels.Expand" disabled="disabled" />
                </div>
            </div>
        </div>
    </div>
</div>
<div class="report-note">
    <span id="note-title" class="note-title">@Labels.Note</span>
    <div id="note-content">
        @Html.Raw(MainResources.WinLossSummary_FilterNote)
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="reportContainer">
        <div id="winlossSumReportContainer">
            <div class="freegrid display-none" id="winlossSumReport"></div>
        </div>
        <div id="gameMatchDetailContainer">
            <div class="freegrid display-none" id="gameMatchDetail"></div>
        </div>
        <div id="scoreInformationContainer">
            <div class="freegrid display-none" id="scoreInformation"></div>
        </div>
        <div id="cockFightingContainer">
			<div class="freegrid display-none" id="cockFightingContent"></div>
		</div>
    </div>
    @Html.Partial("~/Areas/BetList/Views/ScoreInformation/ScoreInformation.cshtml")
</div>
@{
    var today = DateTime.Today;
    var yesterday = today.AddDays(-1);
}
@section scripts
{
    <script type="text/javascript">
        var today = '@today.ToShortDateString()';
        var calToday = '@today.ToShortFormatedDate()';
        var yesterday = '@yesterday.ToShortDateString()';
        var calYesterday = '@yesterday.ToShortFormatedDate()';
        var minDate = '@today.AddMonths(-3).ToShortDateString()';
        var minDateHistory = '@today.AddYears(-2).ToShortDateString()';
        var balanceUp = '@ReportService.BalanceUp.BalanceUpDay';
        var viewResources = {
            From: '@Labels.From',
            To: '@Labels.To',
            Today: '@Labels.Today',
            Yesterday: '@Labels.Yesterday',
            NoFunctionPermission: '@Labels.You_have_no_function_permission',
            // grid columns
            Code: '@Labels.Code',
            Event: '@Labels.Event',
            BetType: '@Labels.Bettype',
            WinLoss: '@Labels.WinLoss',
            Position: '@Labels.Position',
            Comm: '@Labels.Comm',
            LineTotal: '@Labels.LineTotal',
            Variance: '@Labels.Variance',
            Turnover: '@Labels.Turnover',
            Margin: '@Labels.Margin',
            Real: '@Labels.Real',
            Virtual: '@Labels.Virtual',
            Total: '@Labels.Total' + ':',
            _8RM_BARM: '@Labels._8RM_BARM' + ':',
            AllTotal: '@Labels.All_Total' + ':',
            GrandTotal: '@Labels.Grand_Total.ToUpper()' + ':',
            GrandTotal_Lower: '@Labels.Grand_Total' + ':',
            IBCTotal: '@Labels.IBCTotal' + ':',
            Vs: '@Labels.Vs',
            HedgeTotal: '@Labels.Hedge_title' + ':',
            LiveIndicator: '@Labels.LiveIndicator',
            Expand: '@Labels.Expand',
            Collapse: '@Labels.Collapse'
        };
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MonthPicker/monPickr-0.0.3.min.js?ver=10"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/WinLossSummary3rd/Scripts/ReportManager.js?ver=1"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/WinLossSummary3rd/Scripts/WinLossSummary.js?ver=1"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/WinLossSummary3rd/Scripts/GameMatchDetails.js?ver=1"></script>
    <script type="text/javascript" src="~/Areas/Main/Views/WinLossSummary3rd/Scripts/CockFighting.js?ver=1"></script>
}