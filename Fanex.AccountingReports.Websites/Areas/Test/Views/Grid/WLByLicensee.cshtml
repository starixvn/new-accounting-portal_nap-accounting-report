@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Pager/pagination.css" />
}
<div id="gridId" class="freegrid  content-grid">
</div>
@section Foot {
    <script type="text/javascript">
        var headerCusmtomizeRows = [
                 {
                     Columns: [
                            { HeaderText: "Date", Name: "Date", MergeRowNumber: 2 },
                            { HeaderText: "Currency", Name: "Currency", MergeRowNumber: 2 },
                            { HeaderText: "Turnover", Name: "Turnover", MergeRowNumber: 2 },
                            { HeaderText: "Total Trans", Name: "TotalTrans", MergeRowNumber: 2 },
                            { HeaderText: "Customer Win Loss", Name: "CustomerWinLoss", MergeColNumber: 3 },
                            { HeaderText: "", Name: "LicenseeWinLoss", MergeColNumber: 2 },
                            { HeaderText: "Racing Revenue", Name: "RacingWinLoss", MergeColNumber: 3},
                            { HeaderText: "Amount Due To ", Name: "AmountDueToWinLoss", MergeColNumber: 3 }
                        ]
                 }
        ];

                 function GetGridOption(report) {
            var gridOption = {
                customizeHeader: true,
                groupHeaderRows: headerCusmtomizeRows,
                headerColumnHeight: 30,
                bodyRowHeight: 30,
                columns: [
                    { HeaderText: "Date", Width: 100, Name: "Date" },
                    { HeaderText: "Currency", Width: 100, Name: "Currency" },
                    { HeaderText: "Turnover", Width: 100, Name: "Turnover", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Total Trans", Width: 100, Name: "TotalTrans", CellAlign: "right", FormatNumber: "0,0" },
                    { HeaderText: "Win Loss", Width: 100, Name: "CustomerWinLoss", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Comm", Width: 100, Name: "CustomerComm", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Total", Width: 100, Name: "CustomerTotal", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Licensee Win Loss (SB+NG+LC)", Width: 200, Name: "LicenseeWinLoss", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "BA Comm", Width: 100, Name: "BAComm", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Win Loss", Width: 100, Name: "RacingWinLoss", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Comm", Width: 100, Name: "RacingComm", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Total", Width: 100, Name: "RacingTotal", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Win Loss", Width: 100, Name: "AmountDueToWinLoss", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Comm", Width: 100, Name: "AmountDueToComm", CellAlign: "right", FormatNumber: "0,0.00" },
                    { HeaderText: "Total", Width: 100, Name: "AmountDueToTotal", CellAlign: "right", FormatNumber: "0,0.00" }
                ],
                numberOfFrozenColumn: 4,
                showFooter: true,
                showTitle: true,
                titleInfo:
                {
                    HeaderText: "Win Loss by Licensee report for 12Bet from Dec 16, 2012 to Dec 22, 2012 in All Currencies",
                    showExcelButton: true,
                    exportExcelFunction: function () {
                        alert("ExportExcel");
                    }
                },
                showPager: true,
                customPager: true,
                customPagerOption:{
                    callback: function (page_index, itemsPerPage, jq) {
                        alert("pageIndex:" + page_index + ", itemPerPage:" + itemsPerPage + ", jq:" + jq);
                    },
                    startPerPage: 100,
                    stepPerPage: 100,
                    maxTtemsPerPage: 1000,
                    itemsPerPage: 100,
                    currentPage: 1,
                    total_items: 1200
                },
                showDistinctRow: false
            };

            var footerData = [];
            var bodyData = [];
            if (report &&
            report.TransactionList &&
            report.TransactionList.length) {
                var dateGroupNumber = report.TransactionList.length;
                for (var i = 0; i < dateGroupNumber; i++) {
                    var cssClass = i % 2 == 0 ? 'even' : '';
                    var dateGroup = report.TransactionList[i];
                    var dateGroupLength = dateGroup.TransactionList.length;

                    for (var j = 0; j < dateGroupLength; j++) {
                        var reportItem = dateGroup.TransactionList[j];
                        var currentColumns = [];
                        if (j == 0) {
                            currentColumns.push({ Name: "Date", Value: dateGroup.BettingDate, MergeRowNumber: dateGroupLength });
                        }
                        var currentRow = {
                            Columns: currentColumns.concat([
                            { Name: "Currency", Value: reportItem.CurrencyName },
                            { Name: "Turnover", Value: reportItem.Turnover },
                            { Name: "TotalTrans", Value: reportItem.BetCount },
                            { Name: "CustomerWinLoss", Value: reportItem.CustomerWinLoss },
                            { Name: "CustomerComm", Value: reportItem.CustomerComm },
                            { Name: "CustomerTotal", Value: reportItem.CustomerWinLossTotal },
                            { Name: "LicenseeWinLoss", Value: reportItem.LicenseeWinLoss },
                            { Name: "BAComm", Value: reportItem.BAComm },
                            { Name: "RacingWinLoss", Value: reportItem.RacingWinLoss },
                            { Name: "RacingComm", Value: reportItem.RacingComm },
                            { Name: "RacingTotal", Value: reportItem.RacingWinLossTotal },
                            { Name: "AmountDueToWinLoss", Value: reportItem.AmtDuetoBA },
                            { Name: "AmountDueToComm", Value: reportItem.AmtDuetoRacing },
                            { Name: "AmountDueToTotal", Value: reportItem.AmtDuetoCompany }
                            ]),
                            CssClass: cssClass
                        };
                        bodyData.push(
                                currentRow
                            );
                    }
                }

                var totalLength = report.Total.length;
                for (var k = 0; k < totalLength; k++) {
                    var totalItem = report.Total[k];
                     var currentColumns = [];
                    if (k == 0) {
                        currentColumns.push({ Name: "Date", Value: "Total", MergeRowNumber: totalLength });
                    }
                    var currentRow = {
                        Columns: currentColumns.concat([
//                          { Name: "Date", Value: "Total" },
                          { Name: "Currency", Value: totalItem.CurrencyName },
                            { Name: "Turnover", Value: totalItem.Turnover },
                            { Name: "TotalTrans", Value: totalItem.BetCount },
                            { Name: "CustomerWinLoss", Value: totalItem.CustomerWinLoss },
                            { Name: "CustomerComm", Value: totalItem.CustomerComm },
                            { Name: "CustomerTotal", Value: totalItem.CustomerWinLossTotal },
                            { Name: "LicenseeWinLoss", Value: totalItem.LicenseeWinLoss },
                            { Name: "BAComm", Value: totalItem.BAComm },
                            { Name: "RacingWinLoss", Value: totalItem.RacingWinLoss },
                            { Name: "RacingComm", Value: totalItem.RacingComm },
                            { Name: "RacingTotal", Value: totalItem.RacingWinLossTotal },
                            { Name: "AmountDueToWinLoss", Value: totalItem.AmtDuetoBA },
                            { Name: "AmountDueToComm", Value: totalItem.AmtDuetoRacing },
                            { Name: "AmountDueToTotal", Value: totalItem.AmtDuetoCompany }
                    ])
                    };
                    bodyData.push(currentRow);
                }

                var baseCurrencyTotalLength = report.BaseCurrencyTotal.length;
                for (var l = 0; l < baseCurrencyTotalLength; l++) {
                    var baseCurrencyTotalItem = report.BaseCurrencyTotal[l];
                    //self.renderBaseCurrencyTotalRow(baseCurrencyTotalItem, l == 0, baseCurrencyTotalLength, enums.drilldownLevel.Currency);
                    var currentColumns = [];
                    if (l == 0) {
                        currentColumns.push({ Name: "Date", Value: "Total", MergeRowNumber: baseCurrencyTotalLength });
                    }
                      var currentRow = {
                        Columns: currentColumns.concat([
                          { Name: "Currency", Value: baseCurrencyTotalItem.CurrencyName },
                            { Name: "Turnover", Value: baseCurrencyTotalItem.Turnover }
                     ])
                    };
                    if (l == 0) {
                        currentRow.Columns.push({ Name: "TotalTrans", Value: baseCurrencyTotalItem.BetCount, MergeRowNumber: baseCurrencyTotalLength });
                    }
                    currentRow.Columns = currentRow.Columns.concat([
                        { Name: "CustomerWinLoss", Value: baseCurrencyTotalItem.CustomerWinLoss },
                            { Name: "CustomerComm", Value: baseCurrencyTotalItem.CustomerComm },
                            { Name: "CustomerTotal", Value: baseCurrencyTotalItem.CustomerWinLossTotal },
                            { Name: "LicenseeWinLoss", Value: baseCurrencyTotalItem.LicenseeWinLoss },
                            { Name: "BAComm", Value: baseCurrencyTotalItem.BAComm },
                            { Name: "RacingWinLoss", Value: baseCurrencyTotalItem.RacingWinLoss },
                            { Name: "RacingComm", Value: baseCurrencyTotalItem.RacingComm },
                            { Name: "RacingTotal", Value: baseCurrencyTotalItem.RacingWinLossTotal },
                            { Name: "AmountDueToWinLoss", Value: baseCurrencyTotalItem.AmtDuetoBA },
                            { Name: "AmountDueToComm", Value: baseCurrencyTotalItem.AmtDuetoRacing },
                            { Name: "AmountDueToTotal", Value: baseCurrencyTotalItem.AmtDuetoCompany }
                    ]);
                    footerData.push(currentRow);
                }
                gridOption.bodyRows = bodyData;
                gridOption.footerRows = footerData;
            }
            return gridOption;
        }
        $(function () {
            $.ajax({
                type: "POST",
                url: window.rootUrl + "Test/Grid/GetCurrencyReport",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: "",
                beforeSend: function () {
                },
                success: function (rs) {
                    var currentGrid = $("#gridId").fanexGrid(GetGridOption(rs));
                },
                error: function (event, jqXHR, ajaxSettings) {
                },
                complete: function () {
                }
            });
        });
    </script>
}
