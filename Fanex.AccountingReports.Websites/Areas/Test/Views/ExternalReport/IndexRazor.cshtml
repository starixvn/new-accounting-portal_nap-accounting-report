        </div>
    </div>
}

@{
    int index = 0;
    var freezeColumnContent = string.Empty;
    var mainContent = string.Empty;

    var viewData = new ViewDataDictionary(new ViewDataDictionary() { { "index", 0 } });

    foreach (var winlost in Model.WinlossDetails)
    {
        viewData["index"] = ++index;
        freezeColumnContent += Html.Partial("~/Areas/Test/Views/ExternalReport/_IndexFreezeColumn.cshtml",winlost, viewData);
        mainContent += Html.Partial("~/Areas/Test/Views/ExternalReport/_IndexContent.cshtml", winlost);
    }
    
}
