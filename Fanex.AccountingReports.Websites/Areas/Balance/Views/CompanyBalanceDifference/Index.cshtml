@using Fanex.AccountingReports.Balance.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null
        ? AppSession.CurrentWorkingOnMenu.Name :
        string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
}
@section Headline{
    <div class="title">
        <div>
            <span>@Labels.Balance / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
</div>
<div class="content-grid">
    <div id="companyDifferenceReport" class="freegrid display-none">
    </div>
</div>
@section Foot
{
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Balance/Views/CompanyBalanceDifference/Scripts/CompanyBalanceDifference.js?ver=1"></script>
}
