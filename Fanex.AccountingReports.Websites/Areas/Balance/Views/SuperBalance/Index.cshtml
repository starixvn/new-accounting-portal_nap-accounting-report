@using Fanex.AccountingReports.Balance.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/Areas/Balance/Views/SuperBalance/SuperBalance.less" />
}
@section Headline{
    <div class="title">
        <div>
            <span>@Labels.Balance / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div id="directBalanceReportFilter">
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="BalanceType" class="lbl-field col_11 align-left">
                        <div class="col_5 alpha">
                            <input type="radio" name="rdBalance" id="radio-totalbalance" checked="checked" value="1" />
                            <label for="rdTotalBalance">
                                @Labels.TotalBalance</label></div>
                        <div class="col_6 omega">
                            <input type="radio" name="rdBalance" id="radio-yesterdaybalance" value="2" checked="checked" />
                            <label for="rdYesterdayBalance">
                                @Labels.YesterdayBalance</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_3 align-right">
                        @Labels.UserName
                    </div>
                    <div class="edit-field col_6 align-left">
                        <input id="txtUsername" type="text" value="@Labels.Search_All" class="defaultSuggestionBox" />
                    </div>
                    <div class="lbl-field width-152">
                        @Labels.First_Letter
                    </div>
                    <div class="edit-field align-left">
                        <select id="ddlFirstLetter" class="ddlFirstLetter">
                        </select>
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_3 align-right">
                        @Labels.Currency
                    </div>
                    <div class="edit-field col_6 align-left">
                        <select id="ddlCurrency" class="ddlCurrency">
                        </select>
                    </div>
                    <div class="col_6">
                        <input type="checkbox" id="chkViewTotalOnly" class="chkViewTotalOnly" value="@Labels.View_Total_Only"/>
                        <label for="chkViewTotalOnly">@Labels.View_Total_Only</label>
                    </div>
                    <div class="submit col_6 width-auto">
                        <input id="btnGenerate" name="btnGenerate" type="submit" value="@Labels.Generate" />
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="ErrMsg" class="col_35 display-none width-auto">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="superBalanceGrid" class="display-none content-grid width-100percent">
    <div id="superBalanceMainGrid" class="freegrid">
    </div>
</div>
<div id="superBalanceViewTotalContainerGrid" class="display-none content-grid width-100percent">
    <div id="superBalanceViewTotalGrid" class="freegrid">
    </div>
</div>
<div id="superBalanceMasterContainerGrid" class="display-none content-grid width-100percent">
    <div id="superBalanceMasterGrid" class="freegrid">
    </div>
</div>
<div id="superBalanceAgentContainerGrid" class="display-none content-grid width-100percent">
    <div id="superBalanceAgentGrid" class="freegrid">
    </div>
</div>
<div id="superBalanceMemberContainerGrid" class="display-none content-grid width-100percent">
    <div id="superBalanceMemberGrid" class="freegrid">
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var viewResources = {
            Search_All: '@Labels.Search_All'
        };

    </script>
}
@section Foot
{
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/Areas/Balance/Views/SuperBalance/Scripts/SuperBalance.js"></script>
    <script type="text/javascript" src="~/Areas/Balance/Views/SuperBalance/Scripts/SuperBalanceReportManager.js"></script>
}
