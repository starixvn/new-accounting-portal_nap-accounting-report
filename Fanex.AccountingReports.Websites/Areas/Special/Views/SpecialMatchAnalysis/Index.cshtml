@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Special.Resources;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title =
        AppSession.CurrentWorkingOnMenu != null
        ? AppSession.CurrentWorkingOnMenu.Name + " (Base on RM)"
        : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MultipleSelect/jquery.multiselect.css?ver=10" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Special/Views/SpecialMatchAnalysis/Styles/SpecialMatchAnalysis.less">
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Special / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div id="matchSelectionFilter">
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="datepickerplugin" class="lbl-field col_8 align-right">
                    </div>
                </div>
                <div class="lbl-field align-right col_2">
                    @Labels.League</div>
                <div class="edit-field col_20">
                    <select id="ddlLeague">
                    </select>
                </div>
                <div class="submit col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
        </div>
        <div id="matchAnalysisFilter" class="display-none">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_3 align-right width-auto">
                        @Labels.Report_by
                    </div>
                    <div class="edit-field col_4 align-left">
                        <select id="ddlReportBy">
                            <option value="0">@Labels.Currency</option>
                            <option value="1">@Labels.Bettype</option>
                            <option value="2">@Labels.Super</option>
                            <option value="3">@Labels.Member</option>
                        </select>
                    </div>
                    <div class="lbl-field col_3 align-right">
                        @Labels.Bet_Status
                    </div>
                    <div class="edit-field col_4 align-left">
                        <select id="ddlBetStatus">
                            <option value="0" selected="selected">@Labels.All</option>
                            <option value="112">@Labels.Won</option>
                            <option value="113">@Labels.Lose</option>
                            <option value="111">@Labels.Draw</option>
                        </select>
                    </div>
                    <div class="lbl-field col_3 align-right">
                        @Labels.Live_Status
                    </div>
                    <div class="edit-field col_4 align-left">
                        <select id="ddlLiveStatus">
                            <option value="-1">@Labels.All</option>
                            <option value="1">@Labels.Live</option>
                            <option value="0">@Labels.None_live</option>
                        </select>
                    </div>
                    <div class="lbl-field col_3 align-right">
                        @Labels.Bettype
                    </div>
                    <div class="edit-field col_8 align-left ddlBettypeContainer">
                        <select id="ddlBettype">
                        </select>
                    </div>
                    <div class="submit col_4">
                        <input id="btnGenerateMatchAnalysis" name="btnGenerateMatchAnalysis" type="submit"
                            value="GENERATE" />
                    </div>
                    <div class="submit col_4">
                        <input id="btnBackMatchAnalysis" name="btnBackMatchAnalysis" type="submit" value="BACK" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-grid display-inline-block">
    @Html.Partial("MatchSelection")
    @Html.Partial("MatchAnalysisNormal")
    @Html.Partial("MatchAnalysisByMaster")
    @Html.Partial("MatchAnalysisByAgent")
    @Html.Partial("MatchAnalysisByMember")
</div>
@section scripts
{
    <script type="text/javascript">
        var labelDate = '@Labels.Date';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@DateTime.Now.AddMonths(-6)';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MonthPicker/monPickr-0.0.3.min.js?ver=10"></script>
    <script type="text/javascript" src="~/scripts/_lib/MultipleSelect/jquery.multiselect.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/SpecialMatchAnalysis/Scripts/MatchSelection.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/SpecialMatchAnalysis/Scripts/MatchAnalysisBaseReport.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/SpecialMatchAnalysis/Scripts/MatchAnalysisNormal.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/SpecialMatchAnalysis/Scripts/MatchAnalysisByMaster.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/SpecialMatchAnalysis/Scripts/MatchAnalysisByAgent.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/SpecialMatchAnalysis/Scripts/MatchAnalysisByMember.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/SpecialMatchAnalysis/Scripts/MatchAnalysisManager.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/SpecialMatchAnalysis/Scripts/ReportManager.js"></script>
}
