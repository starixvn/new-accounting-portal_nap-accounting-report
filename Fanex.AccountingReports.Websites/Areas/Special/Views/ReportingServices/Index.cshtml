@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Special.Resources;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Core.Web;
@using System.Configuration;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/Areas/Special/Views/ReportingServices/Styles/ReportingServices.less">
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Special / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="reportingServicesContainer" class="content-grid">
    <div id="reportingServicesContent" class="freegrid display-none">
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var defaultPath = '';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/ReportingServices/Scripts/ReportingServices.js"></script>
}
