@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Special.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Services.Impl;

@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
   @Styles.Render("~/scripts/_lib/DatePicker/style")
   <link rel="stylesheet" type="text/css" href="~/Areas/Special/Views/DailyTurnover/Styles/DailyTurnover.less" />
   <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" />
}

@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Special / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_8 align-right">
                </div>
            </div>
            <div class="submit col_4">
                <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
            </div>
        </div>
    </div>
</div>

<div id="DailyTurnoverContainer" class="content-grid display-none">
    <div id="DailyTurnoverContent" class="freegrid">
    </div>
</div>

<span id="ViewDetail" class="content-grid display-none">
    <font color="blue">
        <u id="ViewDetailTurnoverChanged" style="font-weight: bold; font-size: small;cursor: pointer">View detail Turnover changed</u>
    </font>
</span>

<div id="DetailMessage" class="display-none" style="padding-left: 10px;">
    <span>The figures shown in this report reflect the changes of Turnover traced from the day after selected date up to now.</span>
    <br>
    <span>Note that these figures are FOR REFERENCE ONLY as the report just covers some common cases that cause Turnover change, actual changes may be vary.</span>
</div>

<div id="DailyTurnoverDetailContainer" class="content-grid display-none">
    <div id="DailyTurnoverDetailContent" class="freegrid">
    </div>
</div>

<div id="DetailDifferentTurnoverContainer" class="content-grid display-none">
    <div id="DetailDifferentTurnoverContent" class="freegrid">
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        var labelDate = '@Labels.Date';
        var today = '@DateTime.Today.ToShortDateString()';
        var balanceUpDate = '@ReportService.BalanceUp.BalanceUpDay.ToShortDateString()';
    </script>
}

@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/DailyTurnover/Scripts/DailyTurnover.js?v=1"></script>
}