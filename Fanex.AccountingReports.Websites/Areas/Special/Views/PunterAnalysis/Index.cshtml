@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Special.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Services.Impl;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Special/Views/PunterAnalysis/Styles/PunterAnalysis.less">
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Special / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <span id="notemessage" class="note-info-message" title=''></span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Labels.Search_by
                </div>
                <div id="searchBy" class="lbl-field col_8 align-left">
                    <div class="col_3 alpha">
                        <input type="radio" name="rdSearchBy" id="rdSearchByUser" checked="checked" class="rdSearchBy"
                            value="0" />
                        <label for="rdSearchByUser">
                            @Labels.User</label></div>
                    <div class="col_4 omega">
                        <input type="radio" name="rdSearchBy" id="rdSearchByLeague" class="rdSearchBy" value="1" />
                        <label for="rdSearchByLeague">
                            @Labels.League</label></div>
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.Top_rows
                </div>
                <div class="col_7">
                    <input id="txtTopRows" type="text" maxlength="4" />
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.Order_by
                </div>
                <div class="edit-field col_4 align-left">
                    <select id="ddlOrderType" class="alpha">
                        <option value="1">@Labels.Win_Loss</option>
                        <option value="2">@Labels.Turnover</option>
                        <option value="3">@Labels.Margin</option>
                    </select>
                </div>
                <div class="edit-field col_4 align-left">
                    <select id="ddlOrderDirection" class="alpha">
                        <option value="1">@Labels.Descending</option>
                        <option value="0">@Labels.Ascending</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_3 align-right">
                @Labels.Period_type
            </div>
            <div class="edit-field col_8 align-left">
                <select id="ddlPeriodType" class="alpha">
                    <option value="0">@Labels.Daily</option>
                    <option value="1">@Labels.Weekly</option>
                    <option value="2">@Labels.Monthly</option>
                    <option value="3">@Labels.Annualy</option>
                    <option value="4">@Labels.Month_Range</option>
                </select>
            </div>
            <div id="dailyCalendarContainer" class="col_21">
                <div id="dailyCalendar" class="lbl-field">
                </div>
            </div>
            <div id="weeklyCalendarContainer" class="col_21 display-none">
                <div class="lbl-field col_3 align-right alpha">
                    @Labels.From_Date
                </div>
                <div class="edit-field col_7 align-left">
                    <input id="fromWeek" type="text" readonly="readonly" class="weekpicker ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate hasDatepicker" />
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.To_Date
                </div>
                <div class="edit-field col_7 align-left omega">
                    <input id="toWeek" type="text" readonly="readonly" class="weekpicker lfloat txtdate" />
                </div>
            </div>
            <div id="monthlyCalendarContainer" class="col_21 display-none">
                <div class="lbl-field col_3 align-right alpha">
                    @Labels.Month
                </div>
                <div class="edit-field col_3 align-left width-auto">
                    <select id="ddlMonth_MonthlyPicker">
                    </select>
                </div>
                <div class="lbl-field col_2 align-right">
                    @Labels.Year
                </div>
                <div class="edit-field col_5 align-left omega">
                    <select id="ddlYear_MonthlyPicker">
                    </select>
                </div>
            </div>
            <div id="annualyCalendarContainer" class="col_21 display-none">
                <div class="lbl-field col_3 align-right alpha">
                    @Labels.Year
                </div>
                <div class="edit-field col_5 align-left omega">
                    <select id="ddlYear_AnnualyPicker">
                    </select>
                </div>
            </div>
            <div id="monthRangeCalendarContainer" class="col_21 display-none">
                <div class="lbl-field col_3 align-right alpha">
                    @Labels.From
                </div>
                <div class="edit-field col_4 align-left">
                    <select id="ddlFromMonth_MonthRangePicker">
                    </select>
                </div>
                <div class="edit-field col_3 align-left">
                    <select id="ddlFromYear_MonthRangePicker">
                    </select>
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.To
                </div>
                <div class="edit-field col_4 align-left">
                    <select id="ddlToMonth_MonthRangePicker">
                    </select>
                </div>
                <div class="edit-field col_3 align-left omega">
                    <select id="ddlToYear_MonthRangePicker">
                    </select>
                </div>
            </div>
        </div>
        <div id="filterByUser">
            <div class="filter-row">
                <div class="lbl-field col_3 align-right">
                    @Labels.UserName
                </div>
                <div class="col_8">
                    <input id="txtUserName" type="text" maxlength="50" />
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.Product
                </div>
                <div class="edit-field  col_7 align-left ddlProductContainer">
                    <select id="ddlProduct">
                    </select>
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.Sport
                </div>
                <div class="edit-field  col_7 align-left">
                    <select id="ddlSport">
                    </select>
                </div>
            </div>
        </div>
        <div id="filterByLeague" class="display-none">
            <div class="filter-row">
                <div class="lbl-field col_3 align-right">
                    @Labels.Sport
                </div>
                <div class="edit-field  col_8 align-left">
                    <select id="ddlSport_ByLeague">
                    </select>
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.League
                </div>
                <div class="edit-field  col_7 align-left">
                    <select id="ddlLeague_ByLeague">
                    </select>
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_3 align-right">
                    @Labels.Bet_Type
                </div>
                <div class="edit-field  col_8 align-left">
                    <select id="ddlBetType_ByLeague">
                    </select>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="submit col_4 prefix_3">
                <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="errMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="topPunterReportContainer">
        <div id="topPunterReport" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunterByUserContainer">
        <div id="topPunterByUser" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunterBetCount_ByUser_Container">
        <div id="topPunterBetCount_ByUser" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunterIP_ByUser_Container">
        <div id="topPunterIP_ByUser" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunter_ByUser_SportType_Container">
        <div id="topPunter_ByUser_SportType" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunterBetCount_ByUser_SportType_Container">
        <div id="topPunterBetCount_ByUser_SportType" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunterBetCount_ByUser_BetType_Container">
        <div id="topPunterBetCount_ByUser_BetType" class="freegrid display-none">
        </div>
    </div>
    @Html.Partial("~/Areas/Special/Views/PunterAnalysis/TopPunter_ByUser_BetType_MonthRangeSummary.cshtml")
    <div id="topPunter_ByUser_BetType_Container">
        <div id="topPunter_ByUser_BetType" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunterReportByLeagueContainer">
        <div id="topPunterReportByLeague" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunter_ByLeague_UserContainer">
        <div id="topPunter_ByLeague_User" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunterBetCount_ByLeague_UserContainer">
        <div id="topPunterBetCount_ByLeague_User" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunter_ByLeague_SportType_Container">
        <div id="topPunter_ByLeague_SportType" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunterBetCount_ByLeague_SportType_Container">
        <div id="topPunterBetCount_ByLeague_SportType" class="freegrid display-none">
        </div>
    </div>
    <div id="topPunterBetCount_ByLeague_BetType_Container">
        <div id="topPunterBetCount_ByLeague_BetType" class="freegrid display-none">
        </div>
    </div>
    @Html.Partial("~/Areas/Special/Views/PunterAnalysis/TopPunter_ByLeague_BetType_MonthRangeSummary.cshtml")
    <div id="topPunter_ByLeague_BetType_Container">
        <div id="topPunter_ByLeague_BetType" class="freegrid display-none">
        </div>
    </div>
</div>
@{
    var noteMessage = Html.Raw(SpecialResources.PunterAnalysis_FilterNote);
    var minDateDaily = DateTime.Now.AddDays(-121);
    var minDateWeekly = DateTime.Now.AddDays(-121);
}
@section scripts
{
    <script type="text/javascript">
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@DateTime.Today.AddDays(-121).ToShortDateString()';
        var minDateDaily = '@DateTime.Today.AddDays(-121).ToShortDateString()';
        var minDateWeekly = '@DateTime.Today.AddDays(-121).ToShortDateString()';
        var maxDate = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var noteMessage = '@noteMessage';
    </script>
}
@section Foot {
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker")
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MultipleSelect/jquery.multiselect.nlevel.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/DatepickerManager.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/WeekPickerManager.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunterByUser.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunterBetCountByUser.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunterIPByUser.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunter_ByUser_SportType.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunterBetCount_ByUser_SportType.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunterBetCount_ByUser_BetType.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunter_ByUser_BetType.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunter_ByLeague.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunter_ByLeague_User.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunterBetCount_ByLeague_User.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunter_ByLeague_SportType.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunterBetCount_ByLeague_SportType.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunterBetCount_ByLeague_BetType.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/TopPunter_ByLeague_BetType.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/PunterAnalysis/Scripts/ReportManager.js"></script>
}
