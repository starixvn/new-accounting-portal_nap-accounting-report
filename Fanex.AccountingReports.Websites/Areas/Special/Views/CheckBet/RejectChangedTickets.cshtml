
@using Fanex.AccountingReports.Special.Resources;
<div>
<div id="rejectChangedTicketsHeader" class="grid-title display-none" style="width:190px">
    <div class="grid-title-label" id="rejectChangedTicketsTitle">
    </div>
</div>
<div id="rejectChangedTickets" class="freegrid display-none">
    <div class="free-cell free-top-left">
        <table class="grid-fixed-table free-cell-top-left">
            <thead>
                <tr>
                    <th>
                        <div class="table-cell col100 two-row-text">
                            @Labels.RefNo
                        </div>
                    </th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="row_header_wrapper">
        <div class="row_header row-headers-background" id="rejectChangedTicketsRowHeader">
            <table class="grid-fixed-table row_header_content">
                <thead>
                    <tr>
                        <th>
                            <div class="table-cell col100 two-row-text">
                                @Labels.RefNo
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        <th>
                            <div class="table-cell col100 two-row-text">
                                @Labels.RefNo
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col80 two-row-text">
                                @Labels.TransDate</div>
                        </th>
                        <th>
                            <div  class="table-cell col60 two-row-text ">
                                @Labels.Currency</div>
                        </th>
                        <th>
                            <div class="table-cell col140 two-row-text">
                                @Labels.Bettype</div>
                        </th>
                        <th>
                            <div  class="table-cell col140 two-row-text">
                                @Labels.UserName</div>
                        </th>
                        <th>
                            <div class="table-cell col80 two-row-text">
                                @Labels.Stake
                        </th>
                        <th>
                            <div  class="table-cell col80 two-row-text">
                                @Labels.Odds
                            </div>
                        </th>
                        <th>
                            <div  class="table-cell col140 two-row-text">
                                @Labels.Betteam
                            </div>
                        </th>
                        <th>
                            <div  class="table-cell col140 two-row-text">
                                @Labels.TotalPT
                            </div>
                        </th>
                        <th>
                            <div  class="table-cell col60 two-row-text">
                                <span>@Labels.Status</span><br />
                                <span>@Labels.Old</span><span style="color: #ff9000">@Labels.New</span>
                            </div>
                        </th>
                        <th>
                            <div  class="table-cell col140 two-row-text">
                                @Labels.Creator
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div class="content-container">
            <table id="rejectChangedTicketsContent" class="grid-fixed-table col_body_content">
                <thead>
                     <tr>
                        <th>
                            <div class="table-cell col100 two-row-text">
                                @Labels.RefNo
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col80 two-row-text">
                                @Labels.TransDate</div>
                        </th>
                        <th>
                            <div  class="table-cell col60 two-row-text ">
                                @Labels.Currency</div>
                        </th>
                        <th>
                            <div class="table-cell col140 two-row-text">
                                @Labels.Bettype</div>
                        </th>
                        <th>
                            <div  class="table-cell col100 two-row-text">
                                @Labels.UserName</div>
                        </th>
                        <th>
                            <div class="table-cell col80 two-row-text">
                                @Labels.Stake
                        </th>
                        <th>
                            <div  class="table-cell col80 two-row-text">
                                @Labels.Odds
                            </div>
                        </th>
                        <th>
                            <div  class="table-cell col140 two-row-text">
                                @Labels.Betteam
                            </div>
                        </th>
                        <th>
                            <div  class="table-cell col140 two-row-text">
                                @Labels.TotalPT
                            </div>
                        </th>
                        <th>
                            <div  class="table-cell col60 two-row-text">
                                <span>@Labels.Status</span><br />
                                <span>@Labels.Old/</span><span style="color: #ff9000">@Labels.New</span>
                            </div>
                        </th>
                        <th>
                            <div  class="table-cell col100 two-row-text">
                                @Labels.Creator
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row_footer row-footer-background z999">
        <table class="grid-fixed-table row_footer_content">
            <thead>
            </thead>
        </table>
    </div>
    <div class="col_footer row-footer-background scroll-y">
        <div class="footer-container">
            <table class="col_footer_content grid-fixed-table">
                <thead>
                </thead>
            </table>
        </div>
    </div>
</div>
</div>

