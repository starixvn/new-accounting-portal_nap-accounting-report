@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Special.Resources;

@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3.css?ver=1" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less?ver=2" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/BetList/Views/Style/BetList.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Special/Views/CheckBet/Style/CheckBet.less" />
}
@section Headline{
    <div class="title">
        <div>
            <span>@Labels.Special / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div id="checkBetReportFilter">
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="datepickerplugin" class="lbl-field col_8 align-right">
                    </div>
                </div>
                <div class="submit col_4">
                        <input id="btnGenerate" name="btnGenerate" type="submit"
                            value="GENERATE" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-grid">
    <div id="checkBetReportHeader" class="grid-title display-none">
        <div class="grid-title-label" id="checkBetReportTitle">
        </div>
    </div>
    <div id="checkBetReport" class="freegrid display-none">       
        <div class="col_header row-headers-background">
            <div class="header-container">
                <table id="checkBetReportContent" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell col100 height25">
                                    @Labels.CheckTime
                                </div>
                            </th>
                            <th>
                                <div class="table-cell col150 height25">
                                    @Labels.NormalTicket</div>
                            </th>
                            <th>
                                <div class="table-cell col150 height25">
                                    @Labels.RejectTicket</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<br />
<div class="content-grid">
    <div style="padding:5px 0 5px 0px;">@Html.Partial("NormalChangedTickets")</div>
    <div style="padding:5px 0 5px 0px;">@Html.Partial("RejectChangedTickets")</div>
</div>
<div id="betlistContainer" class="">
    <div class="content-grid" id="betListContent" style="margin-top: 10px;">
    </div>
</div>
<div id="combineParlayContainer" class="">
    <div class="content-grid" id="combineParlayContent" style="margin-top: 10px;">
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        minDate = '@Fanex.AccountingReports.Core.Services.Impl.ReportService.BalanceUp.MoveBetsDay.ToShortDateString()';
        currentDate = '@DateTime.Now.ToShortDateString()';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MonthPicker/monPickr-0.0.3.min.js?ver=10"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/CheckBet/Scripts/ReportManager.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/CheckBet/Scripts/CheckBet.js"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/CheckBet/Scripts/NormalChangedTickets.js?ver=1"></script>
    <script type="text/javascript" src="~/Areas/Special/Views/CheckBet/Scripts/RejectChangedTickets.js?ver=1"></script>
}
