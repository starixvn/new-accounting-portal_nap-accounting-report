@using Fanex.AccountingReports.Licensee.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/DatePicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Licensee/Views/AGCasinoWinloss/Styles/Index.less" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Licensee / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <span id="notemessage" class="note-info-message" title=''></span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Labels.Licensee
                </div>
                <div class="edit-field col_7 align-left ddlLicenseeContainer">
                    <select id="LicenseeID" class="col_7 alpha">
                    </select>
                </div>
                <div class="lbl-field col_5 align-right">
                    @Labels.Report_by
                </div>
                <div id="reportBy" class="lbl-field col_7 align-left">
                    <div class="col_3 alpha">
                        <input type="radio" name="ReportType" id="ReportType_Daily" checked="checked" value="1" />
                        <label for="ReportType_Daily">
                            @Labels.Daily</label></div>
                    <div class="col_4 omega">
                        <input type="radio" name="ReportType" id="ReportType_Monthly" value="2" />
                        <label for="ReportType_Monthly">
                            @Labels.Monthly</label></div>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Labels.Currency
                </div>
                <div class="edit-field col_7 align-left ddlCurrencyContainer">
                    <select id="Currency" class="col_7 alpha">
                        <option value="0">All Currencies</option>
                    </select>
                </div>
                <div class="lbl-field col_5 align-right">
                    @Labels.ConvertFiguresTo
                </div>
                <div id="currencyConvert" class="lbl-field col_16 align-left">
                    <div class="col_3 alpha">
                        <input type="radio" name="ConvertFiguresTo" id="ConvertFiguresTo_None" checked="checked"
                            value="0" />
                        <label for="ConvertFiguresTo_None">
                            @Labels.None</label></div>
                    <div class="col_4">
                        <input type="radio" name="ConvertFiguresTo" id="ConvertFiguresTo_MYR" value="5" />
                        <label for="ConvertFiguresTo_MYR">
                            @Labels.MYR</label></div>
                    <div class="col_3">
                        <input type="radio" name="ConvertFiguresTo" id="ConvertFiguresTo_EUR" value="13" />
                        <label for="ConvertFiguresTo_EUR">
                            @Labels.EUR</label></div>
                    <div class="col_3">
                        <input type="radio" name="ConvertFiguresTo" id="ConvertFiguresTo_USD" value="9" />
                        <label for="ConvertFiguresTo_USD">
                            @Labels.USD</label></div>
                    <div class="col_3 omega">
                        <input type="radio" name="ConvertFiguresTo" id="ConvertFiguresTo_GBP" value="17" />
                        <label for="ConvertFiguresTo_GBP">
                            @Labels.GBP</label></div>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_27 align-right">
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                </div>
                <div class="edit-field  col_7 align-left ddlProductContainer">
                    <input id="ExcludeTest" type="checkbox" class="alpha" checked="checked" />
                    <label for="ExcludeTest" class="checkbox-lable">
                        @Labels.Exclude_Test_Data</label>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="submit width-auto col_4 prefix_15">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="PageSize" value='50' />
<input type="hidden" id="PageIndex" value='0' />
<input type="hidden" id="IsRefresh" value='0' />
<input type="hidden" id="CustID" value='0' />
<input type="hidden" id="CustomerName" value='0' />
<input type="hidden" id="CurrencyID" value='0' />
<input type="hidden" id="FromDate_SMAM" value='0' />
<input type="hidden" id="ToDate_SMAM" value='0' />
<div class="content-grid  width-100percent">
    <div id="AGCasinoWinLossMainContainer">
        <div id="AGCasinoWinLossMainGrid" class="freegrid display-none">
        </div>
    </div>
    <div id="AGCasinoWinLossSuperContainer">
        <div id="AGCasinoWinLossSuperGrid" class="freegrid display-none">
        </div>
    </div>
    <div id="AGCasinoWinLossMasterContainer">
        <div id="AGCasinoWinLossMasterGrid" class="freegrid display-none">
        </div>
    </div>
    <div id="AGCasinoWinLossAgentContainer">
        <div id="AGCasinoWinLossAgentGrid" class="freegrid display-none">
        </div>
    </div>
    <div id="AGCasinoWinLossMemberContainer">
        <div id="AGCasinoWinLossMemberGrid" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var noteMessage = '@Html.Raw(LicenseeResources.WinLossByLicensee_FilterNote)';
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@(new DateTime(2005, 1, 1))';
        var maxDate = '@(DateTime.Now.AddDays(-1))';
        var reportTitle = '@Labels.AGCasinoWinlossTitle';
    </script>
}
@section Foot {
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker")
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/PopUp/dialogbox.js"></script>
    <script type="text/javascript" src="~/Areas/Licensee/Views/AGCasinoWinloss/Scripts/Index.js"></script>
}
