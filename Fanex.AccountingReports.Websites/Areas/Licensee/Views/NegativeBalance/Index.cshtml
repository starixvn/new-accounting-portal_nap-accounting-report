@using Fanex.AccountingReports.Licensee.Resources
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/DatePicker/style", "~/scripts/_lib/Fanex.Grid/style")
    <link rel="stylesheet" type="text/css" href="~/Areas/Licensee/Views/NegativeBalance/NegativeBalance.less" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Licensee / </span><span class="curr">@ViewBag.Title</span></div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Labels.Licensee
                </div>
                <div class="edit-field col_5 omega">
                    @Html.DropDownList("dllSite", ViewBag.LicensseSiteList as SelectList, new { id = "dllSite" })
                </div>
                <div class="submit">
                    <input id="btnSubmit" value="Generate" type="submit" />
                </div>
            </div>
            <div id="inforMessage" class="col_35 display-none width-auto">
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="InformationMssg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-grid  width-100percent">
    <div class="grid-title display-none">
        <div class="grid-title-label" id="reporttile">
            @LicenseeResources.NegativeBalance_Report</div>
        <div class="grid-toolbox">
            <input type="button" id="btnSendMail" class="btnSendMail" title="Send Mail" />
            <input type="button" id="btnExport" class="btnExcel" title="Export to Excel" />
        </div>
        <div id="divSendMailContainer" style="display: none;">
        </div>
        <script type="text/x-dot-template" id="scriptSendMailTemplate">
                                <div class="wrapper" >
                                <div class="content" style="width:580px;">
                                <div class="boundary" >
                                <table id="header" >
                                   <tr>
                                      <th style="width:30%">Licensees</th>
                                      <th style="width:40%">To</th>
                                      <th style="width:30%">CC</th>
                                   </tr>
                                </table>
                                </div>
                                <div id="box" class="box">
                                <table id="tbl-content" >
                                    {{~it.Mails :value:index}}
                                                      <tr>
					                                    <td style="width:30%">
						                                   {{=value.Site}}
					                                    </td>
					                                    <td style="width:40%" >
						                                   {{=negativeBalance.bindCCMail(value.To)}}
					                                    </td>
					                                    <td style="width:30%">
						                                   {{=negativeBalance.bindCCMail(value.Cc)}}
					                                    </td>                         
				                                    </tr>           

                                       {{~}}
                                    </table>
                                    </div><!--end #box-->
                                    </div><!--end #content-->
                                    </div><!--end #wrapper-->
                                    <div class="margin-top3">
                                        <span unselectable="on" class="textButtonTable composeHeaderButton colorBTK4" transparent="false"
                                            title="Add receiver"><span class="buttonOutter buttonOutterflatRight colorBT3 colorBTK4">
                                                <div class="subjectSpan">
                                                    Subject:</div>
                                            </span></span>
                                        <input class="compHeaderField inputField colorK3" id="tbxSubject" value="{{=it.Subject}}"
                                            type="text" style="width: 470px; height: 28px;" readonly />
                                    </div>
                                    <div class="margin-top3">
                                        <textarea id="tbxSendMailContent" class="compHeaderField textarea colorK3 contentMail" readonly>{{=it.Content}}</textarea>
                                    </div>
        </script>
    </div>
    <div id="negativeBalance" class="freegrid display-none">
        <div class="free-cell free-top-left">
            <table class="grid-fixed-table free-cell-top-left">
                <thead>
                </thead>
            </table>
        </div>
        <div class="row_header_wrapper">
            <div class="row_header row-headers-background">
                <table class="grid-fixed-table row_header_content" id="tblContentHeader">
                    <thead>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table id="tblContainer" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell withrowNo">
                                    @Labels.No</div>
                            </th>
                            <th>
                                <div id="username" class="table-cell widthUsername">
                                    @Labels.UserName</div>
                            </th>
                            <th>
                                <div id="balance" class="table-cell widthBalance colSorter" onclick="negativeBalance.sort('BALANCE','balanceSorter');">
                                    <div class="display-inline-block">@Labels.Balance</div>
                                    <div id="balanceSorter" class="divSorter">
                                    </div>
                                </div>
                            </th>
                            <th>
                                <div id="currency" class="table-cell widthCurrency ">
                                    @Labels.Currency</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="tblContent" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell rowNo">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="table-cell widthUsername">
                                    @Labels.UserName</div>
                            </th>
                            <th>
                                <div class="table-cell widthCurrency ">
                                    @Labels.Balance</div>
                            </th>
                            <th>
                                <div class="table-cell widthCurrency">
                                    @Labels.Currency</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row_footer row-footer-background z999">
            <table class="grid-fixed-table row_footer_content">
                <thead>
                </thead>
            </table>
        </div>
        <div class="col_footer row-footer-background scroll-y">
            <div class="footer-container">
                <table class="col_footer_content grid-fixed-table">
                    <thead>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
<iframe id="frm" width="0" height="0" style="display: none"></iframe>
@section scripts
{
    <script type="text/javascript">
        var _today = '@DateTime.Today.ToShortDateString()';
        var _yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var _mailContent = 'Please download the attached file for Negative Balance Member(s).<br><br><b>Sent by:</b> @AppSession.CurrentUser.Username .<br><b>Date:</b> @DateTime.Now <br><br><i>This is an auto-mail. Please do not reply.</i>';
    </script>
}
@section Foot {
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker", "~/scripts/_lib/template")
    <script type="text/javascript" src="~/Areas/Licensee/Views/NegativeBalance/NegativeBalance.js?ver=15"></script>
}
