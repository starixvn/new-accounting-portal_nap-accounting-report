@using Fanex.AccountingReports.Licensee.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/Fanex.Grid/style", "~/scripts/_lib/DatePicker/style")
    <link rel="stylesheet" type="text/css" href="~/Areas/Licensee/Views/NumberGameWinLoss/NumberGameWinLoss.less" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Licensee / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <span id="notemessage" class="note-info-message" title='@LicenseeResources.NumberGameWL_NoteMessage'>
    </span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Labels.Licensee
                </div>
                <div class="edit-field col_6">
                    <select id="ddlLicenseese">
                    </select>
                </div>
                <div id="datepickerplugin">
                </div>
                <div class="submit col_4">
                    <input id="btnGenerate" value="Generate" type="submit" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="inforMessage" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-grid  width-100percent">
    <div class="grid-title display-none">
        <div class="grid-title-label" id="reporttile">
            @Labels.Title</div>
        <div class="grid-toolbox">
            <input type="button" id="btnExport" class="btnExcel" title="Export to Excel" />
        </div>
    </div>
    <div id="numbergamewinloss" class="freegrid display-none">
        <div class="free-cell free-top-left">
            <table class="grid-fixed-table free-cell-top-left">
                <thead>
                    <tr>
                        <th>
                            <div class="table-cell licenseeCol">
                                @Labels.Licensee</div>
                        </th>
                        <th>
                            <div class="table-cell turnoverCol">
                                @Labels.Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell totalTransactionCol">
                                @Labels.TotalTransactions</div>
                        </th>
                        <th>
                            <div class="table-cell grossWinCol">
                                @Labels.GrossWin</div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="row_header_wrapper">
            <div class="row_header row-headers-background">
                <table class="grid-fixed-table row_header_content" id="tblContentHeader">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell licenseeCol">
                                    @Labels.Licensee</div>
                            </th>
                            <th>
                                <div class="table-cell turnoverCol">
                                    @Labels.Turnover</div>
                            </th>
                            <th>
                                <div class="table-cell totalTransactionCol">
                                    @Labels.TotalTransactions</div>
                            </th>
                            <th>
                                <div class="table-cell grossWinCol">
                                    @Labels.GrossWin</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <script type="text/x-dot-template" id="row_header_Template">
                        <tr class="winlossdetail">
                            <td>
                                <div class="align-right width100">{{=it.Licensee}}</div>
                            </td>
                            <td>
                                <div class="align-right width120">{{=it.Turnover}}</div>
                            </td>
                            <td>
                                <div class="align-right width100">{{=it.TotalTransaction}}</div>
                            </td>
                            <td>
                                <div class="align-right width100">{{=it.GrossWin}}</div>
                            </td>
                        </tr>
                    </script>
                    <script type="text/x-dot-template" id="row_total_left_template">
                            <tr>
                                <td>
                                    <div class="align-left b width100">{{=it.Licensee}}</div>
                                </td>
                                <td>
                                    <div class="align-right width120">{{=it.Turnover}}</div>
                                </td>
                                <td>
                                    <div class="align-right width100">{{=it.TotalTransaction}}</div>
                                </td>
                                <td>
                                    <div class="align-right width100">{{=it.GrossWin}}</div>
                                </td>
                            </tr>
                    </script>
                    <script type="text/x-dot-template" id="row_empty_left_template">
                            <tr class="hideborderright">
                                <td>
                                    <div class="align-center width100">&nbsp;</div>
                                </td>
                                <td>
                                    <div class="align-right width120">&nbsp;</div>
                                </td>
                                <td>
                                    <div class="align-right width100">&nbsp;</div>
                                </td>
                                <td>
                                    <div class="align-right width100">&nbsp;</div>
                                </td>
                            </tr>
                    </script>
                    <script type="text/x-dot-template" id="revenue_left_template">
                            <tr>
                                <td style="border-right:none 0px;">
                                    <div class="align-center width100">&nbsp;</div>
                                </td>
                                <td style="border-right:none 0px;>
                                    <div class="align-right width120">&nbsp;</div>
                                </td>
                                <td style="border-right:none 0px;>
                                    <div class="align-right width100">&nbsp;</div>
                                </td>
                                <td>
                                    <div class="align-right width100">&nbsp;</div>
                                </td>
                            </tr>
                    </script>
                </table>
            </div>
        </div>
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell licenseeCol">
                                    @Labels.Licensee</div>
                            </th>
                            <th>
                                <div class="table-cell turnoverCol">
                                    @Labels.Turnover</div>
                            </th>
                            <th>
                                <div class="table-cell totalTransactionCol">
                                    @Labels.TotalTransactions</div>
                            </th>
                            <th>
                                <div class="table-cell grossWinCol">
                                    @Labels.GrossWin</div>
                            </th>
                            <th>
                                <div class="table-cell distributorRevenueCol">
                                    @LicenseeResources.DistributorRevenue</div>
                            </th>
                            <th>
                                <div class="table-cell lupineRevenueCol">
                                    @LicenseeResources.LupineRevenue</div>
                            </th>
                            <th>
                                <div class="table-cell amountDueONEWorksCol">
                                    @LicenseeResources.AmountDueONEWorks</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="tblContent" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell licenseeCol">
                                    @Labels.Licensee</div>
                            </th>
                            <th>
                                <div class="table-cell turnoverCol">
                                    @Labels.Turnover</div>
                            </th>
                            <th>
                                <div class="table-cell totalTransactionCol">
                                    @Labels.TotalTransactions</div>
                            </th>
                            <th>
                                <div class="table-cell grossWinCol">
                                    @Labels.GrossWin</div>
                            </th>
                            <th>
                                <div class="table-cell distributorRevenueCol">
                                    @LicenseeResources.DistributorRevenue</div>
                            </th>
                            <th>
                                <div class="table-cell lupineRevenueCol">
                                    @LicenseeResources.LupineRevenue</div>
                            </th>
                            <th>
                                <div class="table-cell amountDueONEWorksCol">
                                    @LicenseeResources.AmountDueONEWorks</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <script type="text/x-dot-template" id="tblContent_Template">
                        <tr class="winlossdetail">
                            <td>
                                <div class="align-center width100">{{=it.Licensee}}</div>
                            </td>
                            <td>
                                <div class="align-right width120">{{=it.Turnover}}</div>
                            </td>
                            <td>
                                <div class="align-right width100">{{=it.TotalTransaction}}</div>
                            </td>
                            <td>
                                <div class="align-right width100">{{=it.GrossWin}}</div>
                            </td>
                            <td>
                                <div class="align-right width100">{{=it.DistributorRevenue}}</div>
                            </td>
                            <td>
                                <div class="align-right width150">{{=it.LupineRevenue}}</div>
                            </td>
                            <td>
                                <div class="align-right width200">{{=it.AmountDueToOneWorks}}</div>
                            </td>
                        </tr>
                    </script>
                    <script type="text/x-dot-template" id="tblContent_Template_Revenue_Info">
                        <tr class="revenueInfo">
                            <td>
                                <div class="align-center width100">&nbsp;</div>
                            </td>
                            <td>
                                <div class="align-right width120">&nbsp;</div>
                            </td>
                            <td>
                                <div class="align-right width100">&nbsp;</div>
                            </td>
                            <td>
                                <div class="align-right width100">&nbsp;</div>
                            </td>
                            <td>
                                <div class="align-center b i width100">{{=it.DistributorRevenue}}</div>
                            </td>
                            <td>
                                <div class="align-center b i width150">{{=it.LupineRevenue}}</div>
                            </td>
                            <td>
                                <div class="align-center b i width200">{{=it.AmountDueToOneWorks}}</div>
                            </td>
                        </tr>
                    </script>
                    <script type="text/x-dot-template" id="tblContent_Template_Total_Row">
                        <tr>
                            <td>
                                <div class="align-center b width100">{{=it.Licensee}}</div>
                            </td>
                            <td>
                                <div class="align-right width120">{{=it.Turnover}}</div>
                            </td>
                            <td>
                                <div class="align-right width100">{{=it.TotalTransaction}}</div>
                            </td>
                            <td>
                                <div class="align-right width100">{{=it.GrossWin}}</div>
                            </td>
                            <td>
                                <div class=" {{ if(it.DistributorRevenue == '-') { }}
                                    align-center
                                    {{ }else { }}
                                    align-right
                                    {{ } }}
                                  b width100">
                                    {{=it.DistributorRevenue}}
                                </div>
                            </td>
                            <td>
                                <div class="align-right b width150">{{=it.LupineRevenue}}</div>
                            </td>
                            <td>
                                <div class="align-right b width200">{{=it.AmountDueToOneWorks}}</div>
                            </td>
                        </tr>
                    </script>
                </table>
            </div>
        </div>
        <div class="row_footer row-footer-background z999">
            <table class="grid-fixed-table row_footer_content">
                <thead>
                </thead>
            </table>
        </div>
        <div class="col_footer row-footer-background scroll-y">
            <div class="footer-container">
                <table class="col_footer_content grid-fixed-table">
                    <thead>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
<iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
@section scripts
{
    <script type="text/javascript">
        var _today = '@DateTime.Today.ToShortDateString()';
        var _yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var _labelFrom = '@Labels.From';
        var _labelTo = '@Labels.To';
        var _selectLicenseeMessage = '@LicenseeResources.PleaseSelectALicensee';
    </script>
}
@section Foot {
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker", "~/scripts/_lib/template")
    <script type="text/javascript" src="~/Areas/Licensee/Views/NumberGameWinLoss/NumberGameWinLoss.js?ver=5"></script>
}
