@using Fanex.AccountingReports.Licensee.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/DatePicker/style")
    <link rel="stylesheet" type="text/css" href="~/Areas/Licensee/Views/PeakConcurrentUsers/PeakConcurrentUser.less" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Licensee / </span><span class="curr">@ViewBag.Title</span></div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin">
                </div>
                <div class="lbl-field col_2 align-right">
                    @LicenseeResources.Site
                </div>
                <div class="edit-field col_6 omega">
                    @Html.DropDownList("dllSite", ViewBag.LicensseSiteList as SelectList, new { id = "dllSite" })
                </div>
                <div class="submit">
                    <input id="btnGenerate" value="Generate" type="submit" onclick="" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="contentBox  width-100percent">
    <div class="content-grid">
        <div class="grid-title display-none">
            <div class="grid-title-label" id="reporttile">
                @Labels.Title</div>
            <div class="grid-toolbox">
                <input type="button" id="btnExport" class="btnExcel" title="Export to Excel" />
            </div>
        </div>
        <div id="peakCocurrentUser" class="freegrid display-none">
            <div class="col_header row-headers-background scroll-y">
                <div class="header-container">
                    <table class="grid-fixed-table col_header_content">
                        <thead>
                            <tr>
                                <th>
                                    <div class="table-cell peakCocurrent">
                                        @Labels.Date
                                    </div>
                                </th>
                                <th>
                                    <div class="table-cell peakCocurrent">
                                        @LicenseeResources.PeakConcurrentUser
                                    </div>
                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            <div class="grid-container container">
                <div class="content-container">
                    <table id="tblContent" class="grid-fixed-table col_header_content">
                        <thead>
                            <tr>
                                <th>
                                    <div class="table-cell peakCocurrent">
                                        @Labels.Date
                                    </div>
                                </th>
                                <th>
                                    <div class="table-cell peakCocurrent">
                                        @LicenseeResources.PeakConcurrentUser
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col_footer row-footer-background">
                <div class="footer-container">
                    <table id="tblContentFooter" class="col_footer_content grid-fixed-table">
                        <thead>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
@section scripts
{
    <script type="text/javascript">
        var _today = '@DateTime.Today.ToShortDateString()';
        var _yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var _minDate = '@DateTime.Today.AddYears(-3).ToShortDateString()';
        var _peakConcurrentUser_Total = '@LicenseeResources.PeakConcurrentUser_Total';
        var _peakConcurrentUser_Average = '@LicenseeResources.PeakConcurrentUser_Average';
        var _peakConcurrentUser_Max = '@LicenseeResources.PeakConcurrentUser_Max';
        var _peakConcurrentUser_Min = '@LicenseeResources.PeakConcurrentUser_Min';
    </script>
}
@section Foot {
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker")
    <script type="text/javascript" src="~/Areas/Licensee/Views/PeakConcurrentUsers/PeakConcurrentUser.js?ver=5"></script>
}
