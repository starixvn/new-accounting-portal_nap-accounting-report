@using Fanex.AccountingReports.Licensee.Resources;
<div id="memberReportHeader" class="grid-title display-none">
    <div class="grid-title-label" id="memberReportTitle">
    </div>
    <div class="grid-toolbox">
        <input id="memberReport_Back" class="btnBack" type="button" title="Back" value=""
            name="btnBack" />
        <input id="memberReport_ExportExcel" class="btnExcel" type="button" title="Export to Excel"
            value="" name="btnExcel" />
    </div>
</div>
<div id="memberReport" class="freegrid display-none">
    <div class="free-cell free-top-left">
        <table class="grid-fixed-table free-cell-top-left">
            <thead>
                <tr>
                    <th>
                        <div class="table-cell col140 height60">
                            @Labels.UserName
                        </div>
                    </th>
                    <th>
                        <div class="table-cell col80 height60">
                            @Labels.Currency</div>
                    </th>
                    <th>
                        <div class="table-cell col140 height60">
                            @Labels.Turnover</div>
                    </th>
                    <th>
                        <div class="table-cell col80 height60">
                            @Labels.TotalTrans</div>
                    </th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="row_header_wrapper">
        <div class="row_header row-headers-background" id="memberReportRowHeader">
            <table class="grid-fixed-table row_header_content">
                <thead>
                    <tr>
                        <th>
                            <div class="table-cell col140 height60">
                                @Labels.UserName
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col80 height60">
                                @Labels.Currency</div>
                        </th>
                        <th>
                            <div class="table-cell col140 height60">
                                @Labels.Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell col80 height60">
                                @Labels.TotalTrans</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        <th rowspan="2">
                            <div class="table-cell col140 height30">
                                @Labels.UserName
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col80 height30">
                                @Labels.Currency</div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col140 height30">
                                @Labels.Turnover</div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col80 height30">
                                @Labels.TotalTrans</div>
                        </th>
                        <th colspan="3">
                            <div class="table-cell col-cust-winloss height25">
                                @Labels.CustomerWinLoss
                            </div>
                        </th>
                        <th colspan="2">
                        </th>
                        <th colspan="3">
                            <div class="table-cell col-racing-revenue height25">
                                @Labels.RacingRevenue
                            </div>
                        </th>
                        <th colspan="3">
                            <div class="table-cell col-amount-due-to height25">
                                @Labels.AmountDueTo
                            </div>
                        </th>
                    </tr>
                    <tr>
                        <th>
                            <div class="table-cell col120 table-cell height30">
                                @Labels.WinLoss</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Comm</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Total</div>
                        </th>
                        <th>
                            <div class="table-cell col155 height30 colLicenseeWinLoss">
                                @Labels.LicenseeWinLoss</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.BAComm</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.WinLoss</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Comm</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Total</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.BA</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Racing</div>
                        </th>
                        <th>
                            <div class="table-cell col155 height30 colIBCAmountDueTo">
                                @Labels.SB+@Labels.NG+@Labels.LC+@Labels._VS+@Labels.CS</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div class="content-container">
            <table id="memberReportContent" class="grid-fixed-table col_body_content">
                <thead>
					<tr>
						<th rowspan="2">
							<div class="table-cell col140 height60">
								@Labels.UserName
							</div>
						</th>
						<th rowspan="2">
							<div class="table-cell col80 height60">
								@Labels.Currency</div>
						</th>
						<th rowspan="2">
							<div class="table-cell col140 height60">
								@Labels.Turnover</div>
						</th>
						<th rowspan="2">
							<div class="table-cell col80 height60">
								@Labels.TotalTrans</div>
						</th>
						<th colspan="3">
							<div class="table-cell col-cust-winloss height25">
								@Labels.CustomerWinLoss
							</div>
						</th>
						<th colspan="2">
						</th>
						<th colspan="3">
							<div class="table-cell col-racing-revenue height25">
								@Labels.RacingRevenue
							</div>
						</th>
						<th colspan="3">
							<div class="table-cell col-amount-due-to height25">
								@Labels.AmountDueTo
							</div>
						</th>
                    </tr>
                    <tr>
                        <th>
                            <div class="table-cell col120 table-cell height30">
                                @Labels.WinLoss</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Comm</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Total</div>
                        </th>
                        <th>
                            <div class="table-cell col155 height30 colLicenseeWinLoss">
                                @Labels.LicenseeWinLoss</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.BAComm</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.WinLoss</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Comm</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Total</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.BA</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height30">
                                @Labels.Racing</div>
                        </th>
                        <th>
                            <div class="table-cell col155 height30 colIBCAmountDueTo">
                                @Labels.SB+@Labels.NG+@Labels.LC+@Labels._VS+@Labels.CS</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row_footer row-footer-background z999">
        <table class="grid-fixed-table row_footer_content">
            <thead>
            </thead>
        </table>
    </div>
    <div class="col_footer row-footer-background scroll-y">
        <div class="footer-container">
            <table class="col_footer_content grid-fixed-table">
                <thead>
                </thead>
            </table>
        </div>
    </div>
</div>
