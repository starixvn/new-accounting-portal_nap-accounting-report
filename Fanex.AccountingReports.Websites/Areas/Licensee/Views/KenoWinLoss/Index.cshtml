@using Fanex.AccountingReports.Licensee.Resources;
@using Fanex.AccountingReports.Core.Web;
@using System.Collections;
@model Fanex.AccountingReports.Licensee.Criteria.KenoWinLoss.GetKenoWinLossCriteria
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/DatePicker/style", "~/scripts/_lib/MultipleSelect/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Licensee/Views/KenoWinLoss/Styles/KenoWinLoss.less" />
    <link href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" rel="stylesheet" type="text/css" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Licensee / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <span id="notemessage" class="note-info-message" title=''></span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_2 align-right">
                    @Labels.Licensee
                </div>
                <div class="edit-field col_7 align-left ddlLicenseeContainer">
                    <select id="ddlLicensee" class="col_6 alpha">
                    </select>
                </div>
                <div class="lbl-field col_4 align-right">
                    @Labels.Currency
                </div>
                <div id="reportBy" class="lbl-field col_6 align-left">
                    <select id="Currency" class="col_6 alpha">
                    </select>
                </div>
                <div class="lbl-field col_4 align-right">
                    @Labels.Country_Market
                </div>
                <div class="lbl-field col_5 align-left">
                    @Html.DropDownListFor(m => m.CountryMarket, (IEnumerable<SelectListItem>)ViewBag.ListCountryMarket)
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_7 align-right">
                </div>
                <div class="submit width-auto col_4 prefix_1">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="kenoWinLossContainer">
        <div id="kenoWinLossContent" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var noteMessage = '@Html.Raw(LicenseeResources.KenoWinLossReportInformation)';
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@(new DateTime(2014, 3, 18))';
        var minDate12BET = '@(new DateTime(2014, 4, 2))';
    </script>
}
@section Foot {
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker")
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/PopUp/dialogbox.js"></script>
    <script type="text/javascript" src="~/Areas/Licensee/Views/KenoWinLoss/Scripts/KenoWinLoss.js"></script>
}
