@using Fanex.AccountingReports.Licensee.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/MonthPicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less?ver=1" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Licensee/Views/TotalTransactions/TotalTransactions.less?ver=10" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Licensee / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <span id="notemessage" class="note-info-message" title=''></span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right width-auto">
                    @Labels.Licensee
                </div>
                <div class="edit-field col_8">
                    <select id="ddlSite">
                    </select>
                </div>
                <div class="lbl-field col_4 align-right width-auto">
                    @Labels.SelectMonth
                </div>
                <div class="edit-field col_7">
                    <div id="ddlMonth">
                    </div>
                </div>
                <div class="lbl-field col_3 align-right width-auto">
                    @Labels.Product
                </div>
                <div class="edit-field col_7 ddlProductContainer">
                    <select id="ddlProduct">
                    </select>
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" class="" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-grid">
    <div id="totalTransReport" class="freegrid display-none">
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var minDate = '@(new DateTime(DateTime.Now.Year - 2, 1, 1))';
        var dateRange = '@DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)';
        var currMonth = '@DateTime.Now.Month'; var currYear = '@DateTime.Now.Year';
        var toDay = '@DateTime.Now.ToShortDateString()';
        var noteMessage = '@Html.Raw(LicenseeResources.TotalTransactionByLicensee_FilterNote)';
    </script>
}
@section Foot {
    @Scripts.Render("~/scripts/_lib/monPickr")
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MultipleSelect/jquery.multiselect.js"></script>
    <script type="text/javascript" src="~/Areas/Licensee/Views/TotalTransactions/ReportManager.js"></script>
    <script type="text/javascript" src="~/Areas/Licensee/Views/TotalTransactions/TotalTransactions.js"></script>
}
