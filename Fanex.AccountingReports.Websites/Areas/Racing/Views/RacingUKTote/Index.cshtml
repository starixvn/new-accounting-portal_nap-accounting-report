@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.WinLoss.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Configurations;
@using Fanex.AccountingReports.Core;
@using Fanex.AccountingReports.Core.Constants;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/scripts/_lib/MonthPicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Racing/Views/RacingUKTote/Styles/RacingUKTote.less" />

}
@section Headline
{
    <div class="title">
        <div>
            <span>@Labels.Racing / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_7 align-right">
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" class="" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="racingDailyWinLossReportContainer">
        <div id="racingDailyWinLossReport" class="freegrid display-none">
        </div>
    </div>
    <div id="racingDailyWinLossDetailReportContainer">
        <div id="racingDailyWinLossDetailReport" class="freegrid display-none">
        </div>
    </div>
    <div id="betListContainer">
        <div class="freegrid display-none" id="betListContent" style="margin-top: 10px;">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var netIncomeFormula = '@Html.Raw(Fanex.AccountingReports.Racing.Resources.RacingResources.NetIncomeFormularUK)';
        var amountDueFormula = '@Html.Raw(Fanex.AccountingReports.Racing.Resources.RacingResources.AmountDueFormularUK)';
        var labelDate = '@Labels.Date';
        var minDate = '@ReportService.BalanceUp.BalanceUpDay.ToShortDateString()';
        var maxDate = '@DateTime.Today.ToShortDateString()';
        var toDay = '@DateTime.Now.ToShortDateString()';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/Areas/Racing/Views/RacingUKTote/Scripts/ReportManager.js"></script>
    <script type="text/javascript" src="~/Areas/Racing/Views/RacingUKTote/Scripts/RacingUKToteMain.js"></script>
    <script type="text/javascript" src="~/Areas/Racing/Views/RacingUKTote/Scripts/RacingUKToteDetail.js"></script>
    <script type="text/javascript" src="~/Areas/Racing/Views/RacingUKTote/Scripts/RacingUKToteBetlist.js"></script>
}
