@using Fanex.AccountingReports.Racing.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Core.Configurations;

@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {   
   @Styles.Render("~/scripts/_lib/DatePicker/style")
   <link rel="stylesheet" type="text/css" href="~/Areas/Racing/Views/RacingWinLossByLicensee/Styles/RacingDailyReport.less" />
}

@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Racing / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div id="filter-bar">
    <div class="filter-form">
        <div>
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="datepickerplugin" class="lbl-field col_2 align-right">
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field col_2 align-right"> @Labels.Licensee
                    </div>
                    <div class="edit-field col_4 align-right">
                        <select id="ListLicensee" class="alpha">
                        </select>
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="submit col_5 align-right">
                        <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="RacingDailyReportContainer" class="display-none content-grid racing-daily-report-container">
    <div id="RacingDailyReportContent" class="freegrid">
    </div>
</div>

<div id="overlay" class="overlay display-none">
</div>

<div id="DetailBetListPopup" class="content-grid">
    <div class="grid-title display-none">
        <div id="DetailBetListTitle" class="grid-title-label"></div>
    </div>
    <div id="DetailBetListContainer" class="freegrid display-none detail-bet-list-container"> 
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell numberCol">
                                    @Labels.No</div>
                            </th>
                            <th>
                                <div class="table-cell memberCol">
                                    @Labels.Member</div>
                            </th>
                            <th>
                                <div class="table-cell usernameCol">
                                    @Labels.Username2</div>
                            </th>
                            <th>
                                <div class="table-cell transactionCol">
                                    @Labels.TransactionTime</div>
                            </th>
                            <th>
                                <div class="table-cell hosrseBetTypeCol">
                                    @Labels.HorseBetType</div>
                            </th>
                            <th>
                                <div class="table-cell oddsCol">
                                    @Labels.Odds</div>
                            </th>
                            <th>
                                <div class="table-cell stakeCol">
                                    @Labels.Stake</div>
                            </th>
                             <th>
                                <div class="table-cell memberWinLossCol">
                                    @Labels.MemberWinLossCommission</div>
                            </th>
                             <th>
                                <div class="table-cell licenseeCol">
                                    @Labels.LicenseeWinLossCommission</div>
                            </th>
                                @if (AppSettings.IsApply50PercentRacingReport)
                                {
                                <th>
                                    <div class="table-cell IBCCol">
                                        @Labels.IBCWinLossCommission</div>
                                </th>
                                } 
                            <th>
                                <div class="table-cell statusCol">
                                    @Labels.Status</div>
                            </th>
                            <th>
                                <div class="table-cell dividendCol">
                                    @Labels.Dividend</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="tblContent" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                           <th>
                                <div class="table-cell numberCol">
                                    @Labels.No</div>
                            </th>
                            <th>
                                <div class="table-cell memberCol">
                                    @Labels.Member</div>
                            </th>
                            <th>
                                <div class="table-cell usernameCol">
                                    @Labels.Username2</div>
                            </th>
                            <th>
                                <div class="table-cell transactionCol">
                                    @Labels.TransactionTime</div>
                            </th>
                            <th>
                                <div class="table-cell hosrseBetTypeCol">
                                    @Labels.HorseBetType</div>
                            </th>
                            <th>
                                <div class="table-cell oddsCol">
                                    @Labels.Odds</div>
                            </th>
                            <th>
                                <div class="table-cell stakeCol">
                                    @Labels.Stake</div>
                            </th>
                             <th>
                                <div class="table-cell memberWinLossCol">
                                    @Labels.MemberWinLossCommission</div>
                            </th>
                             <th>
                                <div class="table-cell licenseeCol">
                                    @Labels.LicenseeWinLossCommission</div>
                            </th>
                                @if (AppSettings.IsApply50PercentRacingReport)
                                {
                                <th>
                                    <div class="table-cell IBCCol">
                                        @Labels.IBCWinLossCommission</div>
                                </th>
                                } 
                            <th>
                                <div class="table-cell statusCol">
                                    @Labels.Status</div>
                            </th>
                            <th>
                                <div class="table-cell dividendCol">
                                    @Labels.Dividend</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>

         <div class="row_footer row-footer-background">
            <table class="grid-fixed-table row_footer_content">
                <thead>
                </thead>
            </table>
        </div>

        <div class="col_footer row-footer-background scroll-y">
            <div class="footer-container">
                <table class="col_footer_content grid-fixed-table">
                    <thead>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        var labelFrom = '@Labels.Date';
        var balanceUpDate = '@ReportService.BalanceUp.BalanceUpDay';
        var IsApply50PercentRacingReport = '@AppSettings.IsApply50PercentRacingReport';
    </script>
}

@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Racing/Views/RacingWinLossByLicensee/Scripts/RacingDailyReport.js"></script>
    <script type="text/javascript" src="~/Areas/Racing/Views/RacingWinLossByLicensee/Scripts/ReportManager.js"></script>
    <script type="text/javascript" src="~/Areas/Racing/Views/RacingWinLossByLicensee/Scripts/RacingDailyReportApply50Percent.js"></script>
}