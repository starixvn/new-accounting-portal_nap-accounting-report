@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.WinLoss.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Configurations;
@using Fanex.AccountingReports.Core;
@using Fanex.AccountingReports.Core.Constants;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/MonthPicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/WinLoss/Views/LeagueWinLoss/Styles/LeagueWinLoss.less?ver=10" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Win_Loss / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_7 align-right">
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" class="" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="leagueWinLossReportContainer">
        <div id="leagueWinLossReport" class="freegrid display-none">
        </div>
    </div>
    <div id="leagueWinLossReportBySportContainer" class="display-none">
        <div id="liveReport">
            <div id="leagueWinLossLiveReportBySport" class="freegrid display-none">
            </div>
        </div>
        <div id="noneLiveReport">
            <div id="leagueWinLossNoneLiveReportBySport" class="freegrid display-none">
            </div>
        </div>
    </div>
    <div id="leagueWinLossReportByBetTypeContainer" class="display-none">
        <div id="leagueWinLossReportByBetType" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var labelDate = '@Labels.Date';
        var minDate = '@(DateTime.Today.AddDays((ReportService.BalanceUp.BalanceUpDay - DateTime.Today).Days).ToShortDateString())';
        var maxDate = '@(DateTime.Today.AddDays(7).ToShortDateString())';
        var toDay = '@DateTime.Now.ToShortDateString()';
        var is8RMActive = '@RMSection.Instance.Report[ReportName.LeagueWinLoss.ToString()].ReportConfigs[RMSection.RMType.EightRM.ToString()].IsActive';
        var isBARMActive = '@RMSection.Instance.Report[ReportName.LeagueWinLoss.ToString()].ReportConfigs[RMSection.RMType.BARM.ToString()].IsActive';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/LeagueWinLoss.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/LeagueWinLossBySport.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/LeagueWinLossByBetType.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/ReportManager.js"></script>
}
