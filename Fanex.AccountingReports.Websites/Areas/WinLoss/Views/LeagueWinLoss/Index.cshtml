@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.WinLoss.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Configurations;
@using Fanex.AccountingReports.Core;
@using Fanex.AccountingReports.Core.Constants;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Multiselect/fanex.multiSelect.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3.css?ver=1" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less?ver=2" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Autocomplete/styles.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/WinLoss/Views/LeagueWinLoss/Styles/LeagueWinLoss.less?ver=10" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Win_Loss / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right bold">
                    @Labels.Sport
                </div>
                <div class="edit-field col_12 align-left ddl-sport">
                    <select id="dropdown-sport"></select>
                </div>
            </div>
            <div id="bettrans-mode" class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_7 align-right">
                </div>
            </div>
            <div id="warehouse-mode" class="filter-cell">
                <div class="lbl-field col_3 align-right bold">
                    @Labels.Month
                </div>
                <div class="edit-field col_13">
                    <div id="dvMonth">
                    </div>
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right bold">
                    @Labels.Turnover
                </div>
                <div class="lbl-field col_9 align-right">
                    <div class="col_3 alpha">
                        <input id="radio-turnover-normal" type="radio" value="0" checked="checked" name="radio-turnover"
                               class="radio-turnover" />
                        <label for="radio-turnover-normal">
                            @Labels.Normal
                        </label>
                    </div>
                    <div class="col_3">
                        <input id="radio-turnover-nodraw" type="radio" value="1" name="radio-turnover"
                               class="radio-turnover" />
                        <label for="radio-turnover-nodraw">
                            @Labels.No_Draw
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right bold">
                    @Labels.League
                </div>
                <div class="edit-field col_12 align-left">
                    <input id="txt-league" type="text" maxlength="200" placeholder="@Labels.League_Name" class="default-suggestionbox" />
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right bold">
                    @Labels.Division
                </div>
                <div class="edit-field col_7 align-left">
                    <select id="dropdown-division"></select>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="submit width-auto col_4 mr-left-80">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" class="" />
                </div>
            </div>
            <div id="bettrans-mode-btn" class="filter-cell">
                <div class="submit width-auto col_4">
                    <input id="btnToday" name="btnToday" type="submit" value="Today" class="" />
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnYesterday" name="btnYesterday" type="submit" value="Yesterday" class="" />
                </div>
            </div>
            <div class="filter-cell">
                <div class="submit width-auto col_4">
                    <input id="btnReportMode" name="btnReportMode" type="submit" value="HISTORY REPORT" class="" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="leagueWinLossReportContainer">
        <div id="leagueWinLossReport" class="freegrid display-none">
        </div>
    </div>
    <div id="leagueWinLossReportMatchesContainer" class="display-none">
        <div id="leagueWinLossReportMatches" class="freegrid display-none">
        </div>
    </div>
    <div id="leagueWinLossBetTypeContainer" class="display-none">
        <div id="leagueWinLossBetType" class="freegrid display-none">
        </div>
    </div>
    <div id="leagueWinLossSiteContainer" class="display-none">
        <div id="leagueWinLossSite" class="freegrid display-none">
        </div>
    </div>
    <div id="leagueWinLossSuperContainer" class="display-none">
        <div id="leagueWinLossSuper" class="freegrid display-none">
        </div>
    </div>
    <div id="leagueWinLossVirtualRateContainer" class="display-none">
        <div id="leagueWinLossVirtualRate" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var labelDate = '@Labels.Date';
        var minDate = '@(ReportService.BalanceUp.MoveBetsDay.AddDays(1).ToShortDateString())';
        var maxDate = '@(DateTime.Today.ToShortDateString())';
        var toDay = '@DateTime.Now.ToShortDateString()';
        var is8RMActive = '@RMSection.Instance.Report[ReportName.LeagueWinLoss.ToString()].ReportConfigs[RMSection.RMType.EightRM.ToString()].IsActive';
        var isBARMActive = '@RMSection.Instance.Report[ReportName.LeagueWinLoss.ToString()].ReportConfigs[RMSection.RMType.BARM.ToString()].IsActive';
        var todayStr = '@DateTime.Now.ToString("MMM dd, yyyy")';
        var yesterdayStr = '@DateTime.Now.AddDays(-1).ToString("MMM dd, yyyy")';
        var minWareHouseDate = '@(new DateTime(2017, 1, 1))';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Fanex.Multiselect/fanex.multiSelect.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MonthPicker/monPickr-0.0.3.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Autocomplete/jquery.autocomplete.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/LeagueWinLoss.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/LeagueWinLossViewBetTypes.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/LeagueWinLossViewMatches.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/LeagueWinLossViewSites.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/LeagueWinLossViewSupers.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/LeagueWinLossViewVirtualRate.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/LeagueWinLoss/Scripts/ReportManager.js"></script>
}