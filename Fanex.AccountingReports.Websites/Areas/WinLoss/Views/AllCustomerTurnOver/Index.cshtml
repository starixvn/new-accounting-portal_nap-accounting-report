@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.WinLoss.Resources;
@using Fanex.AccountingReports.Core.Web;

@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/DatePicker/style", "~/scripts/_lib/Fanex.Grid/style") 
    <link rel="stylesheet" type="text/css" href="~/Areas/WinLoss/Views/AllCustomerTurnOver/Styles/AllCustomerTurnOver.less">
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Win_Loss / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

 <div id="filter-bar">
    <div class="filter-form">
        <div id="betCountReportFilter">
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="datepickerplugin" class="lbl-field col_15 align-right">
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field col_3 align-right">
                        @Labels.Bet_From
                    </div>
                    <div class="edit-field col_3 align-right">
                        <select id="BetFrom" onchange="BetFromOnChange()" class="alpha">
                            <option selected value="i,p">ALL</option>
                            <option value="i">Internet</option>
                            <option value="p">Phone</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell" >
                    <table class="table-button submit" style="width:100%; margin-left:16px;">
                         <tbody>
                            <tr>
                                <td><input class="btn" value="IBC" id="btnIBC" name="btnUBC" type="submit"></td>
                                <td><input class="btn" value="789Y" id="btn789Y" name="btn789Y" type="submit"></td>
                                <td><input class="btn" value="961i.com" id="btn961i" name="btn961i" type="submit"></td>
                                <td><input class="btn" value="k998" id="btnk998" name="btnk998"  type="submit"></td>
                                <td><input class="btn" value="TROJAN" id="btnTROJAN" name="btnTROJAN"  type="submit"></td>
                                <td><input class="btn" value="IBSBET" id="btnIBSBET" name="btnIBSBET"  type="submit"></td>
                                <td><input class="btn" value="KING119" id="btnKING119" name="btnKING119" )" type="submit"></td>
                                <td><input class="btn" value="[ ALL ]" id="btnALL" name="btnALL" type="submit"></td>
                            </tr>
                         </tbody>
                    </table>
                </div>
            </div>
            <div class="display-none">
                <input id="Site" name="site" />
                <input id="SiteType" value="All">
                <input id="FromText" value="Internet + Phone"/>
            </div>
        </div>
    </div>
 </div>

<div id="AllCustomerTurnOverHeader" class="header-report display-none">
    <div class="message-title">
        <div id="AllCustomerTurnOverReportMessageTitle">
        </div>       
    </div>
</div>
     
<div id="AllCustomerTurnOverContainer" class="content-grid display-none report-container">
    <div id="AllCustomerTurnOverReportContent" class="freegrid">
    </div>
</div>


@section scripts
{
    <script type="text/javascript">
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';       
    </script>
}

@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>   
    <script type="text/javascript" src="~/Areas/WinLoss/Views/AllCustomerTurnOver/Scripts/AllCustomerTurnOver.js"></script>
}