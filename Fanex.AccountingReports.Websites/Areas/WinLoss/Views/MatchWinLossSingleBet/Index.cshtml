@using Fanex.AccountingReports.WinLoss.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Extensions;

@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/MonthPicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" />
   <link rel="stylesheet" type="text/css" href="~/Areas/WinLoss/Views/MatchWinLossSingleBet/Styles/MatchWinLossSingleBet.less?ver=10" />
}

@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Win_Loss / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div id="filter-bar">
    <div class="filter-form">
        <div>
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="datepickerplugin" class="lbl-field col_15 align-right">
                    </div>
                </div>
                <div class="submit col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
        </div>
    </div>
</div>

<div id="MatchWinLossSingleBetContainer" class="content-grid display-none">
    <div id="MatchWinLossSingleBetContent" class="freegrid">
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortFormatedDate()';
    </script>
}

@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/Areas/WinLoss/Views/MatchWinLossSingleBet/Scripts/MatchWinLossSingleBet.js"></script>
}

