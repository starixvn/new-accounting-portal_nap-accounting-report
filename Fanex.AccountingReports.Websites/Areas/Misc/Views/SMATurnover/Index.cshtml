@using Fanex.AccountingReports.Misc.Resources;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title =
        AppSession.CurrentWorkingOnMenu != null
        ? AppSession.CurrentWorkingOnMenu.Name
        : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MultipleSelect/jquery.multiselect.css?ver=10" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Misc/Views/SMATurnover/Styles/SMATurnover.less">
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Misc / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div id="matchSelectionFilter">
            <div class="filter-row">
                <div class="lbl-field align-right col_3">
                    <label>@Labels.PeriodType</label>
                </div>
                <div class="edit-field col_4">
                    <select id="ddlPeriodType" class="w100">
                        <option value="1">Daily</option>
                        <option value="2">Monthly</option>
                        <option value="3">Annually</option>
                    </select>
                </div>
                <div id="datePicker" class="filter-cell display-none">
                    <div id="datepickerplugin" class="lbl-field col_8 align-right">
                    </div>
                </div>
                <div id="monthlyFilter" class="display-none">
                    <div class="lbl-field align-right col_2">
                        @Labels.Month</div>
                    <div class="edit-field col_4">
                        <select id="ddlMonth" class="w100">
                            <option value="1">January</option>
                        </select>
                    </div>
                    <div class="lbl-field align-right col_2">
                        @Labels.Year</div>
                    <div class="edit-field col_3">
                        <select id="ddlYear" class="w80">
                            <option value="1">2012</option>
                        </select>
                    </div>
                </div>
                <div id="anuallyFilter" class="display-none">
                    <div class="lbl-field align-right col_2">
                        @Labels.Year</div>
                    <div class="edit-field col_3">
                        <select id="ddlAnualYear" class="w80">
                        </select>
                    </div>
                </div>
                <div class="lbl-field align-right col_3">
                    @Labels.Product</div>
                <div class="edit-field col_6">
                    <select id="ddlProduct">
                    </select>
                </div>
                <div class="lbl-field align-right col_4">
                    @Labels.AccountStatus</div>
                <div class="edit-field col_6">
                    <select id="ddlAccountStatus">
                    </select>
                </div>
                <div class="submit col_6">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-grid display-inline-block">
    <div id="reportContainer" class="display-none">
        <div id="reportContent" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var labelDate = '@Labels.Date';
        var yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var minDate = '@(new DateTime(2012, 1, 1).ToShortDateString())';
        var minYear = '2012';
        var maxYear = '@DateTime.Today.AddMonths(-1).Year';
        var lastMonth = '@DateTime.Today.AddMonths(-1).Month';
        var maxDwhDate = '@ReportService.DWHDateRange.MaxDate.ToShortDateString()';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MultipleSelect/jquery.multiselect.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Misc/Views/SMATurnover/Scripts/SMATurnover.js"></script>
}
