@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Misc.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {   
   @Styles.Render("~/scripts/_lib/DatePicker/style")
    <link rel="stylesheet" type="text/css" href="~/Areas/Misc/Views/DailyCreatedCustomers/DailyCreatedCustomers.less">
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Misc / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div id="betCountReportFilter">
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="datepickerplugin" class="lbl-field col_15 align-right">
                    </div>
                </div>
                <div class="submit col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
        </div>
    </div>
</div>
<div class="display-inline-block">
    <div class="display-inline-block">
        @Html.Partial("SummaryDailyCreatedCustomers")</div>
    <div class="display-inline-block reportDetailsDiv">
        @Html.Partial("DetailsDailyCreatedCustomers")</div>
</div>
@section scripts
{
    <script type="text/javascript">
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';       
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Misc/Views/DailyCreatedCustomers/ReportManager.js"></script>
    <script type="text/javascript" src="~/Areas/Misc/Views/DailyCreatedCustomers/DailyCreatedCustomers.js"></script>
    <script type="text/javascript" src="~/Areas/Misc/Views/DailyCreatedCustomers/DailyCreatedCustomersDetails.js"></script>
}
