@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Misc.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/scripts/_lib/MultipleSelect/style", "~/scripts/_lib/MonthPicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MultipleSelect/jquery.multiselect.css?ver=10" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Misc / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_15 align-right">
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_1 align-right">
                    @Labels.Site
                </div>
                <div class="edit-field col_7 align-left">
                    <select id="ddlSite" class="alpha">
                    </select>
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_2 align-right">
                    @Labels.Amount
                </div>
                <div class="edit-field col_5 align-left">
                    <input type="text" id="txtAmount" maxlength="11" value="@ViewBag.Amount" class="numberic-textbox"/>
                </div>
                <div class="lbl-field col_1 align-left">
                    (@Labels.RM)
                </div>
            </div>
            <div class="filter-cell">
                <div class="submit width-auto col_4 prefix_2">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="@Labels.Generate" />
                </div>
            </div>
        </div>
    </div>
</div>
<div id="reportContainer" class="content-grid display-none">
    <div id="reportContent" class="freegrid display-none">
    </div>
</div>

@{
    var lastMonth = DateTime.Now.AddMonths(-1);
    var firtDateOfLastMonth = new DateTime(lastMonth.Year, lastMonth.Month, 1).ToShortFormatedDate();
}
@section scripts
{
    <script type="text/javascript">
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortFormatedDate()';
        var minDate = '@firtDateOfLastMonth';
        var lasweek = '@DateTime.Today.AddDays(-7).ToShortFormatedDate()';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MonthPicker/monPickr-0.0.3.min.js?ver=10"></script>
    <script type="text/javascript" src="~/scripts/_lib/MultipleSelect/jquery.multiselect.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.setcaretposition.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.caret.1.02.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.formattyping.js"></script>
    <script type="text/javascript" src="~/Areas/Misc/Views/CreditMovement/Scripts/CreditMovement.js"></script>
}
