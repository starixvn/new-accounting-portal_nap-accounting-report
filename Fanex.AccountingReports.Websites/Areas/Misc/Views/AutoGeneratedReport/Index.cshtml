@using Fanex.AccountingReports.Core.Configurations
@using Fanex.AccountingReports.Misc.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @*@Styles.Render("~/scripts/_lib/Fanex.Grid/style")*@
    <link rel="stylesheet" type="text/css" href="~/Areas/Misc/Views/AutoGeneratedReport/Styles/AutoGeneratedReport.less" />
}
@section Headline{
    <div class="title">
        <div>
            <span>@Labels.Misc/ </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div id="NumberGameWLByDateReportFilter">
            <div class="filter-row">
                <div class="today-report">
                    <input id="rdtodayreport" class="hand" type="radio" value="Today Reports" name="reporttype" checked="checked"/>
                    <label for="rdtodayreport">@Labels.Today_Reports</label>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <input id="rdhistoryreport" type="radio" value="History Reports" name="reporttype" class="float-left rd-history-report hand"/>
            <label  for="rdhistoryreport" class="float-left lbl-history-report">@Labels.History_Report</label>
            <div id="report-items-container" class="col_16 report-items display-none">
                <label>@Labels.Report_Name</label>
                <select id="ddlreports" class="ddl-reports">
                </select>
            </div>
            <div class="submit">
	            <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
            </div>
            <span id="iconDownloading" class="ajax-loader display-none"></span>
        </div>
        <div class="clear"></div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="autoGeneratedReportGrid" class="display-none content-grid width-100percent">
    <div id="autoGeneratedReportMainGrid" class="freegrid">
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
		var dockerFileApi = '@AppSettings.DockerFileApi';
    </script>
}
@section Foot
{
    @Scripts.Render("~/scripts/_lib/multiselect", "~/scripts/_lib/nexDatePicker")
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Areas/Misc/Views/AutoGeneratedReport/Scripts/AutoGeneratedReport.js?ver=5"></script>
}
