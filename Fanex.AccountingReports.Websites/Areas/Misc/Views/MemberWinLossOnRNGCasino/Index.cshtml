@using Fanex.AccountingReports.Core.Extensions;
@using Fanex.AccountingReports.Misc.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.AccountingReports.Core.Services.Impl;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/Areas/Misc/Views/MemberWinLossOnRNGCasino/Styles/RNGCasinoReport.less" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/TimePicker/jquery-ui-timepicker-addon.css" />
}
@section Headline{
    <div class="title">
        <div>
            <span>@Labels.Misc/ </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="note-filter-bar">
        <i class="icon-warning"></i>
        <span id="spNote">Report is not automatically refreshed</span>
    </div>
    <div class="toggle-filter-bar float-right " title="Collapse filter">
        <i class="hide-filter-icon" id="show-hide-filter"></i>
    </div>
    <div class="clear-fix">
    </div>
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_2 align-right">
                    Mode
                </div>
                <div class="edit-field col_3">
                    <select id="ddlMode" class="ddl-mode">
                        <option selected="selected" value="Recent">Recent</option>
                        <option value="Historical">Historical</option>
                    </select>
                </div>
                <div class="lbl-field col_5 align-right">
                    Win Loss(RM)
                </div>
                <div class="edit-field col_3">
                    <input type="text" id="txtWinLoss" maxlength="11" style="text-align: right" class="numberic-textbox width80" value="5,000" />
                </div>
                <div id="timeRangeContainer" class="timeRangeContainer col-12 display-none">
                    <div class="lbl-field col_2 align-right">
                        From
                    </div>
                    <div class="edit-field col_8 align-right">
                        <input type="text" value="" readonly="readonly" name="FromTransDate" id="fromTransDate"
                            class="txtCalendar" />GMT-4
                    </div>
                    <div class="lbl-field col_1 align-right">
                        To
                    </div>
                    <div class="edit-field col_8 align-right">
                        <input type="text" value="" readonly="readonly" name="ToTransDate" id="toTransDate"
                            class="txtCalendar" />GMT-4
                    </div>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="submit width-auto col_2 prefix_2">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
        </div>
        <div class="clear">
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div id="recentReportContainer" class="display-none content-grid">
    <div id="recentReportContent" class="freegrid">
    </div>
</div>
<div id="historyReportContainer" class="display-none content-grid">
    <div id="historyReportContent" class="freegrid">
    </div>
</div>
<div id="audioplayer">Alternative content</div>
<input type="hidden" id="nextRefreshTime" />
<input type="hidden" id="numOfMember" />
@section scripts
{
    <script type="text/javascript">
        var fromTime = '@ReportService.ConvertTimeZone(DateTime.Now.AddHours(-1))';
        var toTime = '@ReportService.ConvertTimeZone(DateTime.Now)';
        var minDate = '@ReportService.ConvertTimeZone(ReportService.BalanceUp.MoveBetsDay)';
    </script>
}
@section Foot
{
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.setcaretposition.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.caret.1.02.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.formattyping.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/TimePicker/jquery-ui-timepicker-addon.js?v=1"></script>
    <script type="text/javascript" src="~/Areas/Misc/Views/MemberWinLossOnRNGCasino/Scripts/audio-player.js"></script>
    <script type="text/javascript" src="~/Areas/Misc/Views/MemberWinLossOnRNGCasino/Scripts/RNGCasinoReport.js?ver=1"></script>
}