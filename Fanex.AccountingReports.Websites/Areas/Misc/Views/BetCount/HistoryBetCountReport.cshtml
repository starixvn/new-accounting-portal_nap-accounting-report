@using Fanex.AccountingReports.Misc.Resources;
<div id="historyBetCountReportHeader" class="grid-title display-none">
    <div class="grid-title-label" id="historyBetCountReportTitle">
    </div>
    <div class="grid-toolbox">
        <input id="historyBetCountReport_ExportExcel" class="btnExcel" type="button" title="Export to Excel"
               value="" name="btnExcel" />
    </div>
</div>
<div id="historyBetCountReport" class="freegrid display-none">
    <div class="free-cell free-top-left">
        <table class="grid-fixed-table free-cell-top-left">
            <thead>
                <tr>
                    <th>
                        <div class="table-cell col80 height55">
                            @Labels.Site
                        </div>
                    </th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="row_header_wrapper">
        <div class="row_header row-headers-background" id="historyBetCountReportRowHeader">
            <table class="grid-fixed-table row_header_content">
                <thead>
                    <tr>
                        <th>
                            <div class="table-cell col80 height55">
                                @Labels.Site
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        <th rowspan="2">
                            <div class="table-cell col80 height55">
                                @Labels.Site
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col120 height55">
                                @Labels.Bet_Count
                            </div>
                        </th>
                        <th colspan="3">
                            <div class="table-cell col430 height25">
                                @Labels.Member
                            </div>
                        </th>
                        <th colspan="4">
                            <div class="table-cell col530 height25">
                                @Labels.SMA_Winloss
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col140 height55 colSorter">
                                <div class="display-inline-block">
                                    Commission
                                </div>
                                <div id="colHeaderCommission_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col140 height55 colSorter">
                                <div class="display-inline-block">
                                    Extra PT
                                </div>
                                <div id="colHeaderExtraPT_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col140 height55 colSorter">
                                <div class="display-inline-block">
                                    House Real Income
                                </div>
                                <div id="colHeaderCompanyWinLoss_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                    </tr>
                    <tr>
                        <th>
                            <div class="table-cell col140 table-cell height25 colSorter">
                                <div class="display-inline-block">
                                    @Labels.Turnover
                                </div>
                                <div id="colHeaderTurnover_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col150 height25 colSorter">
                                <div class="display-inline-block">
                                    @Labels.WinLoss
                                </div>
                                <div id="colHeaderMemberWinLoss_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col80 height25 colSorter">
                                <div class="display-inline-block">
                                    @Labels.Margin_Percent
                                </div>
                                <div id="colHeaderMarginPercent_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col140 table-cell height25 colSorter">
                                <div class="display-inline-block">
                                    @Labels.Agent
                                </div>
                                <div id="colHeaderAgentWinLoss_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col140 height25 colSorter">
                                <div class="display-inline-block">
                                    @Labels.Master
                                </div>
                                <div id="colHeaderMasterWinLoss_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col140 height25 colSorter">
                                <div class="display-inline-block">
                                    @Labels.Super
                                </div>
                                <div id="colHeaderSuperWinLoss_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col140 height25 colSorter">
                                <div class="display-inline-block">
                                    @Labels.Total
                                </div>
                                <div id="colHeaderTotal_HistoryReport" class="divSorter">
                                </div>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div class="content-container">
            <table id="historyBetCountReportContent" class="grid-fixed-table col_body_content">
                <thead>
                    <tr>
                        <th rowspan="2">
                            <div class="table-cell col80 height55">
                                @Labels.Site
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col120 height55">
                                @Labels.Bet_Count
                            </div>
                        </th>
                        <th colspan="3">
                            <div class="table-cell col430 height25">
                                @Labels.Member
                            </div>
                        </th>
                        <th colspan="4">
                            <div class="table-cell col530 height25">
                                @Labels.SMA_Winloss
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col140 height55">
                                House Real Income
                            </div>
                        </th>
                    </tr>
                    <tr>
                        <th>
                            <div class="table-cell col140 table-cell height25">
                                @Labels.Turnover
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col150 height25">
                                @Labels.WinLoss
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col80 height25">
                                @Labels.Margin_Percent
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col140 table-cell height25">
                                @Labels.Agent
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col140 height25">
                                @Labels.Master
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col140 height25">
                                @Labels.Super
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col140 height25">
                                @Labels.Total
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <div class="row_footer row-footer-background z999">
        <table class="grid-fixed-table row_footer_content">
            <thead>
            </thead>
        </table>
    </div>
    <div class="col_footer row-footer-background scroll-y">
        <div class="footer-container">
            <table class="col_footer_content grid-fixed-table">
                <thead>
                </thead>
            </table>
        </div>
    </div>
</div>
