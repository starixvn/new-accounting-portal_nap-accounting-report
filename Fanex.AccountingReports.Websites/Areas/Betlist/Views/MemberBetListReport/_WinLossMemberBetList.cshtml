@using Fanex.BetList.Accounting.Models
@using Fanex.BetList.Accounting.Core
@using Fanex.BetList.Accounting.App_GlobalResources
@using Fanex.BetList.Accounting.Extensions;
@model Fanex.BetList.Accounting.Models.BetListDetail
@{
    IList<TicketDetail> ticketDetails = Model != null ? Model.BetDetails : null;
}
<div class="grid-title display-none">
	<div class="grid-title-label">@Model.Title</div>
	<div class="grid-toolbox"><input type="button" name="btnExcel" value="" title="Export to Excel" class="btnExcel" id="btnExcel" onclick="WinLossMemberBetList.ExportBetlist();"/></div>
</div>
<div id="WinLossMemberBetList" class="freegrid display-none">
	<div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
						<th>
							<div class="width50 height34 table-cell">@BetList.lblNo</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetList.transtime</div>
						</th>
						<th>
							<div class="width350 height34 table-cell">@BetList.choice</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.odds</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.stake</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetList.WinLossComm</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetList.LicenseeWLComm</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.status</div>
						</th>
					</tr>
                </thead>
            </table>
        </div>
    </div>
	<div class="grid-container container">
        <div class="content-container">
            <table id="tblContent" class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
						<th>
							<div class="width50 height34 table-cell">&nbsp;</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">&nbsp;</div>
						</th>
						<th>
							<div class="width350 height34 table-cell">&nbsp;</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.odds</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.stake</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetList.WinLossComm</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetList.LicenseeWLComm</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.status</div>
						</th>
					</tr>
                </thead>
                <tbody>
					@if (ticketDetails != null && ticketDetails.Count > 0)
     {
         int index = 0;
         foreach (TicketDetail ticket in ticketDetails)
         {
							<tr>
								<td>
									<div class="width50 c table-cell">@(++index)</div>
								</td>
								<td>
									<div class="width150 c table-cell">
										@Html.Raw(ticket.TransDateHtml)
									</div>
								</td>
								<td class='r bl_evt'>
									<div class="width350 table-cell">
										@Html.Raw(ticket.ChoiceHtml)
										<div id="mixParlay_@ticket.Ticket.RefNo" class="display-none" data-custId="@ticket.Ticket.CustId"></div>
									</div>
								</td>
								<td class='r bl_underdog'>
									<div class="width100 table-cell">
										@Html.Partial("~/Areas/BetList/Views/_Odds.cshtml", ticket)
									</div>
								</td>
								<td class='r bl_underdog'>
									<div class="width100 table-cell">
										@Html.Raw(ticket.StakeHtml)
									</div>
								</td>
								<td class="r">
									<div class="width150 table-cell">
										@Html.Partial("~/Areas/BetList/Views/_WinLoss.cshtml", ticket)
									</div>
								</td>
								<td class="r">
									<div id="comm" class="width150 table-cell">
										@Html.Partial("~/Areas/BetList/Views/_LicenseeWinLoss.cshtml", ticket)
									</div>
								</td>
								<td class="c">
									<div id="status"  class="width100 table-cell">
										@Html.Partial("~/Areas/BetList/Views/_StatusMember.cshtml", ticket)
									</div>
								</td>
							</tr>
         }
     }
     else
     {
						<tr>
							<td colspan="8">
								<div class="height21 c" style="color:Red;font-weight:bold;">There is no data.</div>
							</td>
						</tr>
     }
                </tbody>
            </table>
        </div>
    </div>
	@if (ticketDetails != null && ticketDetails.Count > 0)
 {
		<div class="col_footer row-footer-background scroll-y">
			<div class="footer-container">
				<table class="col_footer_content grid-fixed-table">
					<thead>
						<tr>
							<th colspan="5"><div class="width770 height21 r">Total</div></th>
							<th><div class="width150 height21 r">@Model.TotalWinLoss.Format(2)</div></th>
							<th><div class="width150 height21 r">@Model.TotalLicenseeWinLoss.Format(2)</div></th>
							<th><div class="width100 height21">&nbsp;</div></th>
						</tr>
					</thead>
				</table>
			</div>
		</div>
	}
</div>