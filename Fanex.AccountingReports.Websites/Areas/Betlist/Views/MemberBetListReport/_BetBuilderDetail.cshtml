@using Fanex.BetList.Accounting.Models
@model List<BetBuilderDetailModel>
<div class="betbuilder" style="padding:5px; border-right: 3px solid #000;margin-right: 5px">
    @foreach (var detail in Model)
    {
        <div>
            @detail.SelectionName - <span class="sport" style="text-transform: capitalize">@detail.Result</span>
        </div>
    }
</div>
