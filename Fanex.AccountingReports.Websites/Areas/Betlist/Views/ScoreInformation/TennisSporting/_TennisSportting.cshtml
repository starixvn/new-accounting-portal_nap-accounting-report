<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<link href="@Url.Content("~/Areas/Betlist/Views/Style/BetList.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    @using Fanex.BetList.Accounting.Models
    @using Fanex.BetList.Accounting.Criteria
    @using System.Collections.Generic
    @{
        List<TennisLeagueResult> leagues  = Model;
        GetScoreInformationCriteria criteria = ViewBag.criteria;
        string bettype = (criteria.LiveIndicator == 1 ? "<font color='red'>!Live </font>" : "NON-LIVE ") + criteria.BetTypeName;
        string trader = string.IsNullOrEmpty(criteria.TraderName) && criteria.LiveIndicator == 1 ? criteria.TraderName : "Unassigned";
    }
     @if (leagues.Count > 0)
     {
         foreach (var match in leagues[0].Matchs)
         {
    <div id="tennisPopup" style="margin: 0px 10px; text-align: center;">
        <div style="font-size: 11px; font-weight: bold; margin-bottom: 5px;">
            <span class='sportTypeName_Header'>@criteria.SportTypeName </span>- @criteria.LeagueName
            <br />
            Bettype: @Html.Raw(bettype)
            <br />
            Trader: @trader
        </div>
        @Html.Partial("~/Areas/Betlist/Views/ScoreInformation/TennisSporting/_TennisMatchSporting.cshtml", match)
        @Html.Partial("~/Areas/Betlist/Views/ScoreInformation/TennisSporting/_TennisSetSporting.cshtml", match)
    </div>
         }
     }
      else
    {
         <table style="margin-top: 10px; margin-left: 65px;" id="tbl-content">
        <thead>
            <tr>
                <th>
                    <div class="width150 ">
                        Game Result</div>
                </th>
                @for (int i = 1; i < 14; i++)
                {
                    <th>
                        <div style="width:45px;" class="b">
                            @i</div>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="14" style="font-size: 13px; text-align: center">
                    There is no data.
                </td>
            </tr>
        </tbody>
    </table>
    }
</body>
</html>
