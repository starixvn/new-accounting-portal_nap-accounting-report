@using Fanex.BetList.Accounting.Models
@using Fanex.BetList.Accounting.Extensions;
@using Fanex.BetList.Accounting.App_GlobalResources
@model CombinationParlay
<div id="combineMixParlayDetail" class="freegrid display-none">
    <div id="combineMixParlayDetailHeader" class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr class="gridtitle">
                        <th>
                            <div class="width100 height34 table-cell">@BetList.date</div>
                        </th>
                        <th>
                            <div class="width300 height34 table-cell">@BetList.Event</div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">@BetList.odds</div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">@BetList.stake</div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">@BetList.winloss</div>
                        </th>
                        <th>
                            <div class="width50 height34 table-cell">@BetList.status</div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div class="content-container">
            <table id="tblContent" class="grid-fixed-table col_header_content ">
                <thead>
                    <tr>
                        <th>
                            <div class="width100 height34 table-cell">@BetList.date</div>
                        </th>
                        <th>
                            <div class="width300 height34 table-cell">@BetList.Event</div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">@BetList.odds</div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">@BetList.stake</div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">@BetList.winloss</div>
                        </th>
                        <th>
                            <div class="width50 height34 table-cell">@BetList.status</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.GroupParlayEvents.Count == 0)
                    {
                        <tr>
                            <td rowspan="6" style="width: 750px; text-align: center; color: red; font-weight: bold;">
                                There is no data.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var group in Model.GroupParlayEvents)
                        {
                            bool isFirstRow = true;
                            foreach (var item in group.ParlayEvents)
                            {
                                <tr>
                                    @if (isFirstRow)
                                    {
                                        isFirstRow = false;
                                        <td rowspan="@group.ParlayEvents.Count">
                                            <div class="width100  align-center">
                                                @group.WinLossDate.ToShortFormatedDateWithSlash()
                                            </div>
                                        </td>
                                    }
                                    <td>
                                        <div class="width300  align-center">
                                            @foreach (var match in item.MatchList)
                                            {
                                                <span>@match.Event</span><br />
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="width100  align-right">
                                            <span>@(item.Status.Contains("RUNNING") || item.Status.Contains("LOSE") ? "-" : string.Format("{0:#,##0.####}", item.Odds))</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="width100  align-right">
                                            <span>@item.Stake.Format(2)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="width100  align-right">
                                            <span style="@(item.WinLoss >= 0 ? "" : "color:red;")">@item.WinLoss.Format(2)</span>
                                            <br />
                                            <span>@item.Comm.Format(2)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="width50  align-center">@item.Status</div>
                                    </td>
                                </tr>
                            }

                            <tr class="subTotal">
                                <td colspan="4">
                                    Sub total
                                </td>
                                <td>
                                    <span style="@(group.SubTotal.WinLoss >= 0 ? "" : "color:red;")">@group.SubTotal.WinLoss.Format(2)</span>
                                </td>
                                <td></td>
                            </tr>
                        }
                    }
                    @if (Model != null && Model.GroupParlayEvents.Count > 0)
                    {
                        <tr class="total">
                            <td colspan="4">
                                Total
                            </td>
                            <td>
                                <div class="width100">
                                    <span style="@(Model.Total.WinLoss >= 0 ? "" : "color:red;")">@Model.Total.WinLoss.Format(2)</span>
                                </div>
                            </td>
                            <td>
                                <div class="width50">
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
