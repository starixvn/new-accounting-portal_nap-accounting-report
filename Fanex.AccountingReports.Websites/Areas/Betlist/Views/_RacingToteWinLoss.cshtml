@using Fanex.BetList.Accounting.Models
@using Fanex.BetList.Core.Entities;
@using Fanex.BetList.Accounting.Extensions;
@using Fanex.BetList.Accounting.App_GlobalResources;
@using Fanex.BetList.Accounting.Resources;

@{
    BetListRacingToteWinLoss racingBetList = new BetListRacingToteWinLoss();
    if (Model != null && Model.BetListDetail.Count > 0)
    {
        racingBetList = Model;
    }
   // racingBetList = null;
}

<div class="grid-title display-none">
	<div class="grid-title-label"></div>
	<div class="grid-toolbox"></div>
</div>
<div id="betListRacingTote" class="freegrid display-none">
	<div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
						<th>
							<div class="width50 height34 table-cell">@BetList.lblNo</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetList.transtime</div>
						</th>
                        <th>
							<div class="width150 height34 table-cell">@BetListResources.Member</div>
						</th>
						<th>
							<div class="width350 height34 table-cell">@BetList.choice</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.odds</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.stake</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetListResources.MemberWL</div>
						</th>
                        <th>
							<div class="width150 height34 table-cell">@BetListResources.AgencyWL</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetListResources.IBCWL</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.status</div>
						</th>
                        <th>
							<div class="width100 height34 table-cell">@BetListResources.Dividend</div>
						</th>
					</tr>
                </thead>
            </table>
        </div>
    </div>
	<div class="grid-container container">
        <div class="content-container">
            <table id="tblContent" class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
						<th>
							<div class="width50 height34 table-cell">&nbsp;</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">&nbsp;</div>
						</th>
                        <th>
							<div class="width150 height34 table-cell">&nbsp;</div>
						</th>
						<th>
							<div class="width350 height34 table-cell">&nbsp;</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.odds</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.stake</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetListResources.MemberWL</div>
						</th>
						<th>
							<div class="width150 height34 table-cell">@BetListResources.AgencyWL</div>
						</th>
                        <th>
							<div class="width150 height34 table-cell">@BetListResources.IBCWL</div>
						</th>
						<th>
							<div class="width100 height34 table-cell">@BetList.status</div>
						</th>
                        <th>
							<div class="width100 height34 table-cell">@BetListResources.Dividend</div>
						</th>
					</tr>
                </thead>
                <tbody>
					@if (racingBetList != null && racingBetList.BetListDetail.Count > 0)
     {
         int index = 0;
         foreach (var ticket in racingBetList.BetListDetail)
         {
							<tr>
								<td>
									<div class="width50 c table-cell">@(++index)</div>
								</td>
                                <td>
									<div style class="c table-cell">
										@Html.Raw(ticket.Username)
									</div>
								</td>
                                <td  colspan="9">
									<div class=" c table-cell">
										@Html.Raw(ticket.TransDate)
									</div>
								</td>
							</tr>
         }
     }
     else
     {
						<tr>
							<td colspan="11">
								<div class="height21 c" style="color:Red;font-weight:bold;">There is no data.</div>
							</td>
						</tr>
     }
                </tbody>
            </table>
        </div>
    </div>
@*	@if (racingBetList != null && racingBetList.BetListDetail.Count > 0)
 {
		<div class="col_footer row-footer-background scroll-y">
			<div class="footer-container">
				<table class="col_footer_content grid-fixed-table">
					<thead>
						<tr>
							<th colspan="5"><div class="height21 r" style="width:825px;">Total</div></th>
							<th><div class="width100 height21 r">@racingBetList.Total.Stake</div></th>
							<th><div class="width150 height21 r">@racingBetList.Total.MemberWinLoss</div></th>
                            <th><div class="width150 height21 r">@racingBetList.Total.AgencyPTWinLoss</div></th>
                            <th><div class="width150 height21 r">@racingBetList.Total.IBCPTWinLoss</div></th>
							<th><div class="width100 height21">&nbsp;</div></th>
                            <th><div class="width100 height21 r">@racingBetList.Total.Dividend</div></th>
						</tr>
					</thead>
				</table>
			</div>
		</div>
	}*@
</div>