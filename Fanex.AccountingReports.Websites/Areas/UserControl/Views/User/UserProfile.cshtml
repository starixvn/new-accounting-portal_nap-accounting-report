@using Fanex.AccountingReports.Core.Web
@using Fanex.NAP.Core.Web
@using Fanex.AccountingReports.Core.Resources
@using Fanex.NAP.Core.Models;

@model User
@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool success = ViewBag.Success != null && ViewBag.Success;
    string message = ViewBag.Message != null ? ViewBag.Message : string.Empty;
}
@section Headline {
    <div class="usertitle">
        <div>
            <span>@AppSession.CurrentUser.Username / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
@using (Html.BeginForm())
{
    <div id="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_4">
                        @ViewResources.First_Name
                    </div>
                    <div class="edit-field col_10">
                        <input type="text" id="FirstName" name="FirstName" class="userprofile" value="@Model.FirstName" />
                    </div>
                </div>
            </div>
             <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_4">
                        @ViewResources.Last_Name
                    </div>
                    <div class="edit-field col_10">
                        <input type="text" id="LastName" name="LastName" class="userprofile" value="@Model.LastName" />
                    </div>
                </div>
            </div>
             <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_4">
                        @ViewResources.Email
                    </div>
                    <div class="edit-field col_10">
                        <input type="text" id="Email" name="Email" class="userprofile" value="@Model.Email"  />
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_4"></div>
                <div class="filter-cell">
                     <div class="submit width-auto col_3">
                        <input id="btnSave" name="btnGenerate" type="submit" value="Save" class="" />
                    </div>
                     <div class="cancel width-auto col_3">
                        <input id="btnCancel" name="btnGenerate" type="button" value="Cancel" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section Foot {

 <script type="text/javascript">
     var success = @success.ToString().ToLower();
     var message = '@message';
     var re = @Html.Raw(@"/\S+@\S+\.\S+/");
     $(function () {
        if(success == true)
        {
            AccReport.popUp.show('@Labels.ChangedProfile', null, 1);
        }
        else if(message != '')
        {
            AccReport.popUp.show(message);
        }

        $("#btnSave").on("click",function(){
            var email = $("#Email").val();
            if(email != ""
            && !re.test(email))
            {
                AccReport.popUp.show('@Labels.InvalidEmail', "Email");
                return false;
            }
        });

        $("#btnCancel").on("click",function(){
            window.location.href = '@Url.Action("Index","Home", new { Area = "" })';
            return false;
        });
     })
 </script>
}