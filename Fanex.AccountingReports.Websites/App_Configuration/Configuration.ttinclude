<#@ import namespace="System" #>
<#
    var sites = new SiteInfo[]{
		new SiteInfo
        {
            Environment = SiteEnvironment.DEV
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.LOCAL
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.SIT
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.UAT
        },
       
        new SiteInfo
        {
            Environment = SiteEnvironment.PRO
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.PROAWS
        },
		 new SiteInfo
        {
            Environment = SiteEnvironment.KLDR
        }
    };
#>
<#+
    enum SiteEnvironment
    {
		DEV,
        LOCAL,		
        SIT,
        UAT,
        MNL,
        PRO,
        PROAWS,
		KLDR
    }
    class SiteInfo
    {
        public SiteEnvironment Environment { get; set; }

        #region For Webconfig file
	   
	   public string NapEnvironment
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                    case SiteEnvironment.MNL:
					case SiteEnvironment.KLDR:
                        return "LIVE";
                    default:
                        return "UAT";
                }
            }
        }

        public string NapSiteId
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                    case SiteEnvironment.MNL:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
					case SiteEnvironment.KLDR:
                        return "4";
                    default:
                        return "3";
                }
            }
        }

		public string NapEnableReCheckin
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.PRO:
						return "true";
					default:
                        return "false";
                }
            }
        }

		public string NapServiceUrls
		 {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
						return "http://nap_api_netcore.nexdev.net:8787";
                    case SiteEnvironment.SIT:
						return "http://172.16.2.44:8788";
                    case SiteEnvironment.UAT:
						return "http://10.2.27.8:8788";
					case SiteEnvironment.PRO:
                        return "http://10.2.27.8:8788";
                    case SiteEnvironment.PROAWS:
						return "http://vn-net-lb-fb2f50db9dc92512.elb.ap-northeast-1.amazonaws.com:8788";
					case SiteEnvironment.MNL:
                        return "http://10.2.27.8:8788";
					case SiteEnvironment.KLDR:
                        return "http://10.143.8.200:1710";
					default:
                        return string.Empty;
                }
            }
        }
		

		public string NapDomainName
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
						return "localhost:9902";
                    case SiteEnvironment.SIT:
                        return "nap-report.playthefun.com";
                    case SiteEnvironment.UAT:
						return "qa-accrpt.starific.net";
					case SiteEnvironment.PRO:
                        return "nap.oneops.net";
                    case SiteEnvironment.PROAWS:
                        return "reports.sportsfun.app";
					case SiteEnvironment.MNL:
                        return "nap-report.ibcbk.com";
					case SiteEnvironment.KLDR:
                        return "reports.byb6181.com";
					default:
                        return string.Empty;
                }
            }
        }

		public string NapDomainPath
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
                    case SiteEnvironment.SIT:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
					case SiteEnvironment.MNL:
					case SiteEnvironment.KLDR:
						return "/AccReport";
					default:
                        return string.Empty;
                }
            }
        }

		public string ONEbookUMAddress
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
					    return "https://onebookum-dev.nexdev.net/api";
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                        return "http://10.2.27.8:7446/api";
                    case SiteEnvironment.UAT:
                        return "http://10.2.190.41:7446/api";
                    case SiteEnvironment.SIT:
                        return "http://172.16.2.44:7446/api";
                    case SiteEnvironment.MNL:
                        return "http://10.40.40.202:8889/api";
					case SiteEnvironment.KLDR:
                        return "http://10.143.8.200:8889/api";
                    default:
                        return string.Empty;
                }
            }
        }

        public string EnableCheckUM
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "true";
                    default:
                        return "false";
                }
            }
        }


        public string LoggingDefaultCategory
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.UAT:
                        return "NAP-Report-UAT";
                    case SiteEnvironment.SIT:
						return "NAP-Report-SIT";
					case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                    case SiteEnvironment.MNL:
					case SiteEnvironment.KLDR:
                        return "NAP-Report";
                    default:
                        return "NAP-Report-LOCAL";
                }
            }
        }		

        public string DebugMode
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                    case SiteEnvironment.MNL:
					case SiteEnvironment.KLDR:
						return "false";
                    default:
                        return "true";
                }
            }
        }

		public string ErrorMode
        {
            get
            {
                switch(Environment)
                {
				    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                    case SiteEnvironment.MNL:
					case SiteEnvironment.KLDR:
						return "On";
                    default:
                        return "Off";
                }
            }
        }

        public string StateConnectionString
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.UAT:
						return "stateConnectionString=\"tcpip=10.2.27.8:42424\"";
                    case SiteEnvironment.SIT:
                        return "stateConnectionString=\"tcpip=172.16.4.107:42424\"";
                    case SiteEnvironment.PRO:                    
                        return "stateConnectionString=\"tcpip=10.2.27.8:42424\"";
                    case SiteEnvironment.PROAWS:
                        return "stateConnectionString=\"tcpip=10.2.27.19:42424\"";
                    case SiteEnvironment.MNL:
                        return "stateConnectionString=\"tcpip=10.2.12.10:42424\"";
					case SiteEnvironment.KLDR:
                        return "stateConnectionString=\"tcpip=10.143.8.200:42424\"";

                    default:
                        return "stateConnectionString=\"tcpip=10.18.200.131:42424\"";
                }
            }
        }

        #endregion End for Webconfig file
    }
#>