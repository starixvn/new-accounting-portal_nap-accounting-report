@using Fanex.AccountingReports.Core.Configurations;
@using Fanex.AccountingReports.Core.Models;
@using Fanex.AccountingReports.Core.Services.Impl;
@using Fanex.AccountingReports.Core.Resources;
@using Fanex.AccountingReports.Core.Web;
@using Fanex.NAP.Core.Web;
@using Fanex.NAP.Core.Configuration;
<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.Title</title>
    <meta http-equiv="cleartype" content="on" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <script src="~/scripts/_lib/html5shiv.min.js" type="text/javascript"></script>
    @Styles.Render("~/themes/style", "~/scripts/_lib/Tooltip/style", "~/themes/base/jquery/style")
    <link type="text/css" rel="Stylesheet" href="~/scripts/_lib/Fanex.Grid/Fanex.Grid.css?ver=2" />
    <link type="text/css" rel="Stylesheet" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css?ver=1" />
    <link type="text/css" rel="Stylesheet" href="~/themes/base/style.less" />
    <link type="text/css" rel="stylesheet" href="~/scripts/_lib/CustomScrollbar/Styles/scrollbars.css" />
    <link type="text/css" rel="stylesheet" href="~/scripts/_lib/CustomScrollbar/Styles/scrollbars-itunes.css" />
    <link type="text/css" rel="stylesheet" href="~/scripts/_lib/CustomScrollbar/Styles/scrollbars-custom.css" />
    <link type="text/css" rel="stylesheet" href="~/Areas/Uncategorized/ReportLegend/FanexLegend.less" />
    @RenderSection("Head", false)
</head>
<body>

    <header>
        <div class="logo">
            <a href="~/?ref=logo">&nbsp;</a>
        </div>
        @Html.Action("_Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
        <div class="user-info">
            <div class="greeting">
                <h2>
                    Welcome <span class="info-acc">@HttpContext.Current.User.Identity.Name</span><span class="info-more"></span>
                </h2>
                <ul>
                    <li>
                        <a href='@Url.Content("~/Auth/ChangePassword")'>Change Password</a>
                    </li>
                    <li>
                        <a href='@Url.Content("~/Auth/LogOut")'>Sign out</a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <section id="headline">
        @RenderSection("Headline", false)
    </section>
    <section id="body">
        <div class="content" id="dvcontent">
            @RenderBody()
        </div>
    </section>
    <div id="dialog-message">
    </div>
    <div id="dialog-popup">
    </div>
    <div id="previewReportLegendDialog" class="display-none">
    </div>

    @Html.Hidden("AccReportRoot", Url.Content("~/Admin/"))
    @Html.Hidden("NapHubRoot", Url.Content("~/"))
    @Scripts.Render("~/scripts-bundle/jquery")
    @Scripts.Render("~/scripts/_lib/msgbox/JS")
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/CrossdomainAjax/jquery.xdomainajax.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/CustomScrollbar/jquery.event.drag-2.0.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/CustomScrollbar/jquery.ba-resize.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/CustomScrollbar/mousehold.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/CustomScrollbar/jquery.mousewheel.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/CustomScrollbar/aplweb.scrollbars.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/jquery.fileDownload.js"></script>
    <script type="text/javascript" src="~/Areas/Uncategorized/ReportLegend/FanexLegend.js"></script>
    @{
        var currentUsername = HttpContext.Current.User.Identity.Name ?? string.Empty;
    }

    @if (NapSettings.Settings.EnableReCheckIn && !currentUsername.StartsWith("starix"))
    {
    <script src="@Url.Content("~/auth/recheckinscript")" type="text/javascript"></script>
    }

    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        window.rootWebPath = '@(Request.Url.GetLeftPart(UriPartial.Authority) + Request.ApplicationPath)';
        var port = '@Request.Url.Port';
        var isUsingPort = '@(AppSettings.IsUsingPort)';
        if(isUsingPort == 'False')
        {
            window.rootWebPath = window.rootWebPath.replace(':' + port, '');
        }

        var isLiveEnviroment = '@NapSettings.Settings.Environment' == 'LIVE';
        if (isLiveEnviroment = 'True')
        {
            window.rootWebPath = window.rootWebPath.replace('http://', 'https://');
        }

        var currentMenuId = @(AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Id : 0);
        var isDisableMostvisitedPage = @(AppSettings.IsDisableMostvisitedPage != null ? AppSettings.IsDisableMostvisitedPage.ToString().ToLower() : "false");

        var getReportLegendUrl = 'LegendManagement/LegendManagement/GetJsonpReportLegend';
        var inlineImageExpand = "@Labels.ReportLegend_SubTabHeadLineIcon_Expand_Image";
        var inlineImageCollapse = "@Labels.ReportLegend_SubTabHeadLineIcon_Collapse_Image";
        var menuId = "@(AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Id : -1)";
        var functionName = "@(AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.FunctionName : string.Empty)";
        var menuName = "@(AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty)";

        //Set fix width for filter-bar
        $("#filter-bar").css("width", ($(window).width() - 20) + "px");
        $(window).resize(function () {
            var width = $(window).width() - 20; //padding-right: 10 + padding-left: 10
            $("#filter-bar").css("width", width + "px");
        });
    </script>
    @RenderSection("Scripts", false)
    @RenderSection("Foot", false)

</body>
</html>