@using Fanex.AccountingReports.Core.Resources;
@using Fanex.AccountingReports.Licensee.Resources;
@using Fanex.AccountingReports.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MultipleSelect/jquery.multiselect.css?ver=10" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3.css?ver=1" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/monPickr-0.0.3-custom.less?ver=1" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/MonthPicker/redmond/jquery-ui-1.8.17.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/Test/Style/TotalTransactions.less?ver=11" />
}
@section Headline {
    <div class="title">
        <div>
            <span>Customer / </span><span class="curr">Statement</span>
        </div>
    </div>
}
<div id="filter-bar">
    <span id="notemessage" class="note-info-message" title=''></span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right width-auto">
                    @Labels.Licensee
                </div>
                <div class="edit-field col_8">
                    <select id="ddlSite">
                    </select>
                </div>
                <div class="lbl-field col_4 align-right width-auto">
                    @Labels.SelectMonth
                </div>
                <div class="edit-field col_7">
                    <div id="dllMonth">
                    </div>
                </div>
                <div class="lbl-field col_3 align-right width-auto">
                    @Labels.Product
                </div>
                <div class="edit-field col_7">
                    <select id="ddlProduct">
                    </select>
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" class="" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-grid">
    <div class="grid-title display-none">
        <div class="grid-title-lable" id="reporttile">
            Dwlspnl Statement</div>
        <div class="grid-toolbox">
            <input class="btExpand expanded" type="button" title="Collapse/Expand" value="" />
            <input id="totalTransactionsReport_ExportExcel" class="btnExcel" type="button" title="Export to Excel"
                value="" name="btnExport" />
        </div>
    </div>
    <div id="agentReport" class="freegrid display-none">
        <div class="free-cell free-top-left">
            <table class="grid-fixed-table free-cell-top-left">
                <thead>
                    <tr>
                        <th>
                            <div class="table-cell col140 height60">
                                @Labels.UserName
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col100 height60">
                                @Labels.Currency</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height60">
                                @Labels.Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell col120 height60">
                                @Labels.TotalTrans</div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="row_header_wrapper">
            <div class="row_header row-headers-background" id="agentReportRowHeader">
                <table class="grid-fixed-table row_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell col140 height60">
                                    @Labels.UserName
                                </div>
                            </th>
                            <th>
                                <div class="table-cell col100 height60">
                                    @Labels.Currency</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height60">
                                    @Labels.Turnover</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height60">
                                    @Labels.TotalTrans</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th rowspan="2">
                                <div class="table-cell col140 height30">
                                    @Labels.UserName
                                </div>
                            </th>
                            <th rowspan="2">
                                <div class="table-cell col100 height30">
                                    @Labels.Currency</div>
                            </th>
                            <th rowspan="2">
                                <div class="table-cell col120 height30">
                                    @Labels.Turnover</div>
                            </th>
                            <th rowspan="2">
                                <div class="table-cell col120 height30">
                                    @Labels.TotalTrans</div>
                            </th>
                            <th colspan="3">
                                <div class="table-cell col370 height25">
                                    @Labels.CustomerWinLoss
                                </div>
                            </th>
                            <th colspan="2">
                            </th>
                            <th colspan="3">
                                <div class="table-cell col370 height25">
                                    @Labels.RacingRevenue
                                </div>
                            </th>
                            <th colspan="3">
                                <div class="table-cell col370 height25">
                                    @Labels.AmountDueTo
                                </div>
                            </th>
                        </tr>
                        <tr>
                            <th>
                                <div class="table-cell col120 table-cell height30">
                                    @Labels.WinLoss</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Comm</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Total</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30 colLicenseeWinLoss">
                                    @Labels.LicenseeWinLoss</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.BAComm</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.WinLoss</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Comm</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Total</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.BA</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Racing</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30 colIBCAmountDueTo">
                                    @Labels.SB+@Labels.NG+@Labels.LC</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="agentReportContent" class="grid-fixed-table col_body_content">
                    <thead>
                        <tr>
                            <th rowspan="2">
                                <div class="table-cell col140 height60">
                                    @Labels.UserName
                                </div>
                            </th>
                            <th rowspan="2">
                                <div class="table-cell col100 height60">
                                    @Labels.Currency</div>
                            </th>
                            <th rowspan="2">
                                <div class="table-cell col120 height60">
                                    @Labels.Turnover</div>
                            </th>
                            <th rowspan="2">
                                <div class="table-cell col120 height60">
                                    @Labels.TotalTrans</div>
                            </th>
                            <th colspan="3">
                                <div class="table-cell col370 height25">
                                    @Labels.CustomerWinLoss
                                </div>
                            </th>
                            <th colspan="2">
                            </th>
                            <th colspan="3">
                                <div class="table-cell col370 height25">
                                    @Labels.RacingRevenue
                                </div>
                            </th>
                            <th colspan="3">
                                <div class="table-cell col370 height25">
                                    @Labels.AmountDueTo
                                </div>
                            </th>
                        </tr>
                        <tr>
                            <th>
                                <div class="table-cell col120 table-cell height30">
                                    @Labels.WinLoss</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Comm</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Total</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30 colLicenseeWinLoss">
                                    @Labels.LicenseeWinLoss</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.BAComm</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.WinLoss</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Comm</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Total</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.BA</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30">
                                    @Labels.Racing</div>
                            </th>
                            <th>
                                <div class="table-cell col120 height30 colIBCAmountDueTo">
                                    @Labels.SB+@Labels.NG+@Labels.LC</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row_footer row-footer-background z999">
            <table class="grid-fixed-table row_footer_content">
                <thead>
                </thead>
            </table>
        </div>
        <div class="col_footer row-footer-background scroll-y">
            <div class="footer-container">
                <table class="col_footer_content grid-fixed-table">
                    <thead>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var minDate = '@(new DateTime(DateTime.Now.Year - 2, 1, 1))';
        var dateRange = '@DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)';
        var currMonth = '@DateTime.Now.Month'; var currYear = '@DateTime.Now.Year';
        var toDay = '@DateTime.Now.ToShortDateString()';
        var noteMessage = '@Html.Raw(LicenseeResources.TotalTransactionByLicensee_FilterNote)';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/MonthPicker/monPickr-0.0.3.min.js?ver=1"></script>
    <script type="text/javascript" src="~/scripts/_lib/MultipleSelect/jquery.multiselect.min.js?ver=3"></script>
    <script type="text/javascript" src="~/Views/Test/Scripts/TotalTransactions.js?ver=8"></script>
}
